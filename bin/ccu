#!/bin/bash
# ccu: run and control the containercomp desktop from the Mac host.
# Run `ccu help` for usage.
set -euo pipefail

# Resolve the repo root through symlinks (macOS bash 3.2 has no readlink -f guarantee).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
REPO=$(cd -P "$(dirname "$src")/.." && pwd)

TARGET=${CCU_TARGET:-native}
SHOT_DIR=${CCU_SHOT_DIR:-${TMPDIR:-/tmp}/ccu}
SCREEN=${CCU_SCREEN:-1280x800}

# Audit log settings forwarded to cu in the container (`-e VAR` passes VAR only
# if it is set here), and the host-side mirror of the log's entries.
AUDIT_LOG=/var/log/ccu/audit/audit.jsonl
AUDIT_ENV=(-e CCU_AUDIT_SOURCE=cli -e CCU_AUDIT -e CCU_AUDIT_SHOTS -e CCU_AUDIT_MAX_SHOTS
           -e CCU_AUDIT_TYPE -e CCU_AUDIT_SHOT_DELAY -e CCU_RECORD_FPS)
AUDIT_MIRROR=${CCU_AUDIT_MIRROR:-default}
case "${CCU_AUDIT:-1}:$AUDIT_MIRROR" in
    0:*|*:0) AUDIT_MIRROR=off ;;
    *:off) ;;
    *) AUDIT_ENV+=(-e CCU_AUDIT_ECHO=1) ;;
esac

usage() {
    cat <<'EOF'
ccu: a Linux desktop in a Podman container, driven by mouse/keyboard/screenshots.

usage: ccu [-t native|x86] <command> [args]

  -t native   arm64 Ubuntu desktop (default, fast)
  -t x86      amd64 Ubuntu desktop under emulation, with Wine for Windows apps
              (or set CCU_TARGET=x86)

Lifecycle
  build                 build (or rebuild) the image
  up [--from SNAP] [--egress FILE | --offline] [--upstream URL|none]
                        start the desktop (builds the image first if needed);
                        --from creates the container from a snapshot,
                        --egress/--offline limit network access (see "Network")
  down                  stop the container (state is kept)
  rm                    delete the container (state is lost; the image stays)
  reset [--from SNAP | --base] [--egress FILE | --offline] [--upstream URL|none]
                        recreate the container from the snapshot it came from
                        (or another snapshot, or the base image) and start it
  status                show container status and the viewer URL
  open                  open the noVNC viewer in your browser
  logs [service]        desktop logs (xvfb, desktop, x11vnc, novnc)
  shell [--root]        interactive shell in the container
  exec [--root] CMD...  run a command in the container
  mcp                   stdio MCP server (for `claude mcp add containercomp -- ccu mcp`)

Snapshots (images named <image>-snap-NAME; pin a known-good state, reset to it)
  snapshot save NAME [-m DESC] [--force]   commit the container (paused if running)
  snapshot list         snapshots of the current image; * marks the container's
  snapshot rm NAME...   delete snapshots
  snapshot export NAME FILE.tar | snapshot import FILE.tar [NAME]

Apps and files
  install TARGET...     apt package names, URLs, or host files (.deb, .AppImage,
                        .exe/.msi on x86, archives); host files go to ~/apps
  cp-in HOST [DEST]     copy a host file into the container (default ~/apps/)
  cp-out SRC [HOST]     copy a container file to the host (default: current dir)

Corporate networks (TLS-inspecting proxies such as Zscaler or Netskope)
  certs sync [--machine]   copy the extra roots macOS trusts (keychains, MDM) for
                        the container; --machine also trusts them in the podman VM
                        (for podman pull; changes the VM shared by all containers)
  certs add FILE [NAME] trust a CA file (PEM or DER); for non-mac hosts too
  certs rm NAME | certs list | certs apply   (apply re-pushes to the running one)
  Stored certs apply on every `up`, to the running container, and to `build`.
  HTTP(S)_PROXY / NO_PROXY from your shell are passed in when the container is
  created (localhost becomes host.containers.internal); CCU_PROXY=0 disables.

Screen control (coordinates are screen pixels; screenshot pixels = click pixels)
  screenshot [FILE]     save a PNG, print its path
  zoom X0 Y0 X1 Y1 [--scale N] [FILE]   enlarged crop of a region
  click X Y [--button left|right|middle] [--mods ctrl+shift]
  double_click X Y | triple_click X Y | right_click X Y | middle_click X Y
  move X Y              mouse_down | mouse_up
  drag X0 Y0 X1 Y1
  scroll X Y up|down|left|right [AMOUNT]
  type TEXT             newlines press Return
  key COMBO...          xdotool names: ctrl+s Return Escape Tab alt+F4 super
  launch CMD...         start a GUI app in the background
  windows | active | size | cursor
  focus TITLE           raise the window whose title contains TITLE
  wait_window TITLE [--timeout S]
  wait SECONDS

Add --shot to any control command to take a screenshot afterwards and print its path.

Audit and recording (every action is logged; see README "Audit and recording")
  audit tail [N]        last N audit log entries (JSONL)
  audit verify          check the log's hash chain and compare it with the host mirror
  audit export [DIR]    copy the log, its screenshots and an HTML timeline to the host
  record start [FILE]   record the screen with ffmpeg (5 fps .mp4) until `record stop`
  record stop           finish the recording, copy it to the host, print its path
  record status

Network (egress allowlist; chosen when the container is created)
  egress [status]       show the mode and the allowlist
  egress log [-f] [--all] [-n N]   blocked requests (--all: allowed ones too)
  egress set FILE|offline          replace the allowlist of a filtered desktop
  FILE has one domain per line: "example.com" allows just that host,
  "*.example.com" or ".example.com" allows it and all subdomains; # comments.
  Only proxy-aware traffic (HTTP_PROXY/HTTPS_PROXY are preset) gets out.
  The egress proxy forwards through an upstream proxy: --upstream URL, else
  CCU_UPSTREAM_PROXY, else the host's HTTPS_PROXY/HTTP_PROXY (not with
  CCU_PROXY=0); "none" connects directly. Host NO_PROXY hosts go direct.

Environment: CCU_TARGET, CCU_SCREEN (default 1280x800), CCU_PORT, CCU_NAME,
CCU_IMAGE, CCU_SHOT_DIR, VNC_PASSWORD (applied when the container is created).
Audit: CCU_AUDIT (1|0), CCU_AUDIT_SHOTS (1|0), CCU_AUDIT_MAX_SHOTS (500),
CCU_AUDIT_TYPE (length|hash|full), CCU_AUDIT_MIRROR (host file or off), CCU_RECORD_FPS (5).
Network: CCU_EGRESS (FILE or "offline", same as up --egress), CCU_EGRESS_IMAGE,
CCU_UPSTREAM_PROXY (same as up --upstream),
CCU_CA_FILE (extra CA files, colon-separated), CCU_CERT_DIR (default
~/.config/containercomp/certs), CCU_PROXY (0 = don't pass host proxy settings in).
EOF
}

die() { echo "ccu: $*" >&2; exit 1; }

set_target() {
    case "$TARGET" in
        native|arm64) TARGET=native; PLATFORM=linux/arm64; NAME=${CCU_NAME:-ccu}; PORT=${CCU_PORT:-6080} ;;
        x86|amd64) TARGET=x86; PLATFORM=linux/amd64; NAME=${CCU_NAME:-ccu-x86}; PORT=${CCU_PORT:-6081} ;;
        *) die "unknown target '$TARGET' (use native or x86)" ;;
    esac
    IMAGE=${CCU_IMAGE:-localhost/containercomp:$TARGET}
}

state() { podman container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo missing; }

require_running() {
    [ "$(state)" = running ] || die "container '$NAME' is not running; start it with: ccu${TARGET_FLAG} up"
}

# podman exec as the desktop user with the display env (and audit settings).
pexec() {
    if [ "$AUDIT_MIRROR" = off ]; then
        podman exec -u user -w /home/user -e DISPLAY=:1 "${AUDIT_ENV[@]}" "$NAME" "$@"
    else
        podman exec -u user -w /home/user -e DISPLAY=:1 "${AUDIT_ENV[@]}" "$NAME" "$@" 2> >(audit_tee)
    fi
}

# Container stderr filter: audit entries (lines starting "ccu-audit<TAB>") are
# appended to the host mirror; everything else passes through to stderr.
audit_tee() {
    mkdir -p "$(dirname "$AUDIT_MIRROR")" 2>/dev/null || true
    awk -v f="$AUDIT_MIRROR" 'index($0, "ccu-audit\t") == 1 { print substr($0, 11) >> f; fflush(f); next }
        { print > "/dev/stderr"; fflush("/dev/stderr") }'
}

# Log a host-side event (file copies, interactive shells) in the audit log.
audit_note() { pexec cu audit note "$@" >/dev/null || true; }

ensure_machine() {
    # On macOS podman needs its Linux VM running.
    if [ "$(uname -s)" = Darwin ] && ! podman info >/dev/null 2>&1; then
        echo "starting podman machine..." >&2
        podman machine start >/dev/null 2>&1 || podman machine init --now \
            || die "could not start the podman machine; run 'podman machine init --now' manually"
    fi
}

cmd_build() {
    ensure_machine
    echo "building $IMAGE ($PLATFORM); the x86 build is slow under emulation" >&2
    # Behind a TLS-inspecting proxy the build needs its CA and proxy too.
    local ca
    ca=$(ca_bundle)
    proxy_opts --build-arg
    [ -z "$ca" ] || PROXY_OPTS+=(--build-arg "CCU_EXTRA_CA=$ca")
    podman build ${PROXY_OPTS[@]+"${PROXY_OPTS[@]}"} --platform "$PLATFORM" -t "$IMAGE" -f "$REPO/Containerfile" "$REPO"
}

wait_ready() {
    local i
    for i in $(seq 1 90); do
        if pexec xdotool getdisplaygeometry >/dev/null 2>&1 && pexec test -f /home/user/.cache/ccu/session.env; then
            # Give the panel and window manager a moment to map.
            sleep 2
            return 0
        fi
        sleep 1
    done
    die "desktop did not come up; check: ccu${TARGET_FLAG} logs desktop"
}

check_rosetta() {
    # On Apple Silicon, x86 runs far better (and 64-bit Windows apps only work)
    # with Rosetta, which Podman 5.6+ leaves disabled by default.
    [ "$TARGET" = x86 ] && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || return 0
    podman machine ssh 'test -e /proc/sys/fs/binfmt_misc/rosetta' >/dev/null 2>&1 && return 0
    cat >&2 <<'EOF'
warning: Rosetta is not active in the podman machine, so x86 runs under qemu
(slow, and Wine fails to load most .exe files). On macOS 26+ enable it with:
  podman machine ssh "sudo touch /etc/containers/enable-rosetta"
  podman machine stop && podman machine start
EOF
}

cmd_up() {
    local from="" run_image=$IMAGE cur rest=() nrest=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --from) [ $# -ge 2 ] || die "usage: ccu up --from SNAPSHOT"; from=$2; snap_check_name "$from"; shift 2 ;;
            --from=*) from=${1#*=}; snap_check_name "$from"; shift ;;
            *) rest+=("$1"); nrest=$((nrest + 1)); shift ;;
        esac
    done
    if [ "$nrest" -gt 0 ]; then egress_parse_up "${rest[@]}"; else egress_parse_up; fi
    ensure_machine
    check_rosetta
    if [ -n "$from" ]; then
        snap_require "$from"
        run_image=$(snap_ref "$from")
        cur=$(snap_from)
        [ "$(state)" = missing ] || [ "$cur" = "$from" ] \
            || die "container '$NAME' already exists (from ${cur:-the base image}); use: ccu${TARGET_FLAG} reset --from $from"
    fi
    egress_pre_up
    case "$(state)" in
        running) ;;
        missing)
            [ -n "$from" ] || podman image exists "$IMAGE" || cmd_build
            egress_create
            local w=${SCREEN%x*} h=${SCREEN#*x}
            proxy_opts -e
            # In egress mode the egress proxy is the only way out; don't pass the
            # host's proxy settings in on top of it.
            if [ -n "$EGRESS_REQ" ]; then PROXY_OPTS=(--http-proxy=false); fi
            podman run -d --name "$NAME" --hostname "$NAME" \
                --platform "$PLATFORM" \
                -p "127.0.0.1:$PORT:6080" \
                --shm-size 2g \
                -e SCREEN_WIDTH="$w" -e SCREEN_HEIGHT="$h" \
                -e VNC_PASSWORD="${VNC_PASSWORD:-}" \
                -e CCU_INSTANCE="$(new_instance_id)" \
                --label containercomp.target="$TARGET" \
                --label containercomp.from="$from" \
                ${PROXY_OPTS[@]+"${PROXY_OPTS[@]}"} \
                ${EGRESS_ARGS[@]+"${EGRESS_ARGS[@]}"} \
                "$run_image" >/dev/null
            ;;
        *) podman start "$NAME" >/dev/null ;;
    esac
    netsetup apply
    wait_ready
    echo "desktop '$NAME' is up: $(pexec cu size | tr ' ' x) at http://localhost:$PORT/"
}

cmd_status() {
    local s
    s=$(state)
    echo "target:    $TARGET ($PLATFORM)"
    echo "container: $NAME ($s)"
    echo "image:     $IMAGE ($(podman image exists "$IMAGE" && echo present || echo 'not built'))"
    [ "$s" = missing ] || cmd_status_from
    echo "egress:    $(egress_summary)"
    if [ "$s" = running ]; then
        echo "viewer:    http://localhost:$PORT/"
        echo "screen:    $(pexec cu size | tr ' ' x)"
        echo "windows:"
        pexec cu windows | sed 's/^/  /'
    fi
}

# Which snapshot the container was created from, and whether it changed since.
cmd_status_from() {
    local from ref
    from=$(snap_from)
    if [ -z "$from" ]; then
        echo "from:      base image (no snapshot)"
        return 0
    fi
    ref=$(snap_ref "$from")
    if ! podman image exists "$ref"; then
        echo "from:      snapshot '$from' (since deleted)"
    elif [ "$(podman container inspect -f '{{.Image}}' "$NAME")" != "$(podman image inspect -f '{{.Id}}' "$ref")" ]; then
        echo "from:      snapshot '$from' (since replaced; reset uses the new one)"
    else
        echo "from:      snapshot '$from' ($ref)"
    fi
}

# Unique per created container. A container made from a snapshot inherits the
# snapshot's audit log; the entrypoint archives it when this ID differs.
new_instance_id() {
    uuidgen 2>/dev/null | tr 'A-Z' 'a-z' || echo "$(date +%s)-$$-$RANDOM"
}

new_shot_path() {
    mkdir -p "$SHOT_DIR"
    echo "$SHOT_DIR/$NAME-$(date +%Y%m%d-%H%M%S)-$$-$RANDOM.png"
}

cmd_screenshot() {
    local out=${1:-$(new_shot_path)}
    pexec cu screenshot > "$out"
    [ -s "$out" ] || die "screenshot failed"
    echo "$out"
}

cmd_zoom() {
    local args=() out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --scale) args+=("$1" "$2"); shift 2 ;;
            *.png) out=$1; shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ -n "$out" ] || out=$(new_shot_path)
    pexec cu zoom "${args[@]}" > "$out"
    [ -s "$out" ] || die "zoom failed"
    echo "$out"
}

cmd_install() {
    [ $# -gt 0 ] || die "usage: ccu install <apt-package|url|host-file>..."
    local targets=() a dest
    for a in "$@"; do
        if [ -f "$a" ]; then
            dest=/home/user/apps/$(basename "$a")
            podman exec "$NAME" mkdir -p /home/user/apps
            podman cp "$a" "$NAME:$dest"
            podman exec "$NAME" chown user:user /home/user/apps "$dest"
            targets+=("$dest")
        else
            targets+=("$a")
        fi
    done
    pexec cu exec --root --action install -- /usr/local/bin/ccu-install "${targets[@]}"
}

cmd_cp_in() {
    [ $# -ge 1 ] || die "usage: ccu cp-in HOST_PATH [CONTAINER_DEST]"
    local dest=${2:-/home/user/apps/}
    podman exec "$NAME" mkdir -p /home/user/apps
    podman cp "$1" "$NAME:$dest"
    audit_note cp-in "host=$1" "dest=$dest"
    podman exec "$NAME" chown -R user:user /home/user/apps
    case "$dest" in /home/user/*) podman exec "$NAME" chown -R user:user "$dest" ;; esac
    echo "copied to $dest"
}

cmd_cp_out() {
    [ $# -ge 1 ] || die "usage: ccu cp-out CONTAINER_PATH [HOST_DEST]"
    local src=$1
    case "$src" in /*) ;; *) src=/home/user/$src ;; esac
    podman cp "$NAME:$src" "${2:-.}"
    audit_note cp-out "src=$src" "host=${2:-.}"
}

# --- audit log and session recording -------------------------------------------

cmd_audit() {
    local sub=${1:-}
    [ $# -eq 0 ] || shift
    case "$sub" in
        tail) pexec tail -n "${1:-20}" "$AUDIT_LOG" ;;
        verify) audit_verify ;;
        export) audit_export "$@" ;;
        *) die "usage: ccu audit tail [N] | verify | export [DIR]" ;;
    esac
}

audit_verify() {
    local rc=0 tmp start missing extra
    pexec cu audit verify || rc=1
    if [ "$AUDIT_MIRROR" = off ] || [ ! -s "$AUDIT_MIRROR" ]; then
        echo "host mirror: none"
        return $rc
    fi
    tmp=$(mktemp -d)
    podman exec "$NAME" cat "$AUDIT_LOG" > "$tmp/log" 2>/dev/null || true
    # Compare from the mirror's last seq-1 entry; earlier ones are from removed containers.
    start=$(grep -n '^{"seq":1,' "$AUDIT_MIRROR" | tail -n 1 | cut -d: -f1)
    tail -n +"${start:-1}" "$AUDIT_MIRROR" > "$tmp/mirror"
    missing=$(grep -cvxFf "$tmp/log" "$tmp/mirror" || true)
    extra=$(grep -cvxFf "$tmp/mirror" "$tmp/log" || true)
    rm -rf "$tmp"
    echo "host mirror $AUDIT_MIRROR: $missing mirrored entries missing or changed in the container log, $extra container entries not mirrored"
    [ "$missing" = 0 ] || rc=1
    return $rc
}

audit_export() {
    local dir=${1:-$SHOT_DIR/audit-$NAME-$(date +%Y%m%d-%H%M%S)}
    mkdir -p "$dir"
    pexec cu audit html >/dev/null
    podman cp "$NAME:/var/log/ccu/audit/." "$dir/"
    if [ "$AUDIT_MIRROR" != off ] && [ -f "$AUDIT_MIRROR" ]; then
        cp "$AUDIT_MIRROR" "$dir/host-mirror.jsonl"
    fi
    audit_verify > "$dir/verify.txt" 2>&1 || echo "ccu: verification found problems, see $dir/verify.txt" >&2
    echo "$(cd "$dir" && pwd)/index.html"
}

cmd_record() {
    local f out src dest
    case "${1:-status}" in
        start)
            f=${2:-$SHOT_DIR/$NAME-$(date +%Y%m%d-%H%M%S).mp4}
            case "$f" in /*) ;; *) f=$PWD/$f ;; esac
            mkdir -p "$(dirname "$f")"
            pexec cu record start --host-path "$f"
            echo "run 'ccu${TARGET_FLAG} record stop' to finish; it will be saved to $f"
            ;;
        stop)
            out=$(pexec cu record stop)
            IFS=$'\t' read -r src dest <<< "$out"
            [ -n "$dest" ] || dest=$SHOT_DIR/$(basename "$src")
            podman cp "$NAME:$src" "$dest"
            echo "$dest"
            ;;
        status) pexec cu record status ;;
        *) die "usage: ccu record start [FILE.mp4] | stop | status" ;;
    esac
}

# --- snapshots ----------------------------------------------------------------
# A snapshot is the container committed to the image <IMAGE>-snap-NAME, so it
# follows CCU_IMAGE and the target. A container records the snapshot it was
# created from in the label containercomp.from (empty: the base image).

snap_check_name() {
    case "${1:-}" in
        "") die "missing snapshot name (see: ccu snapshot list)" ;;
        [!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) die "bad snapshot name '$1' (use letters, digits, '.', '_', '-')" ;;
    esac
    [ ${#1} -le 64 ] || die "snapshot name is longer than 64 characters"
}

# Image reference for snapshot $1 (with no argument: the common prefix).
snap_ref() {
    case "${IMAGE##*/}" in
        *:*) echo "$IMAGE-snap-${1:-}" ;;
        *) echo "$IMAGE:latest-snap-${1:-}" ;;
    esac
}

snap_require() {
    snap_check_name "$1"
    podman image exists "$(snap_ref "$1")" \
        || die "no snapshot '$1' for $IMAGE (see: ccu${TARGET_FLAG} snapshot list)"
}

# Snapshot the existing container was created from ("" for the base image).
snap_from() {
    [ "$(state)" != missing ] || return 0
    podman container inspect -f '{{index .Config.Labels "containercomp.from"}}' "$NAME"
}

snap_names() {
    local prefix ref
    prefix=$(snap_ref)
    podman images --format '{{.Repository}}:{{.Tag}}' | while read -r ref; do
        case "$ref" in "$prefix"?*) echo "${ref#"$prefix"}" ;; esac
    done | sort -u
}

snap_save() {
    local name="" desc="" force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -m|--message) [ $# -ge 2 ] || die "$1 needs a description"; desc=$2; shift 2 ;;
            -f|--force) force=1; shift ;;
            -*) die "unknown option '$1' (usage: ccu snapshot save NAME [-m DESC] [--force])" ;;
            *) [ -z "$name" ] || die "usage: ccu snapshot save NAME [-m DESC] [--force]"; name=$1; shift ;;
        esac
    done
    snap_check_name "$name"
    ensure_machine
    local s ref old="" pause=false
    s=$(state)
    [ "$s" != missing ] || die "container '$NAME' does not exist; nothing to snapshot"
    ref=$(snap_ref "$name")
    if podman image exists "$ref"; then
        [ "$force" = 1 ] || die "snapshot '$name' already exists; add --force to replace it"
        old=$(podman image inspect -f '{{.Id}}' "$ref")
    fi
    # Quotes and backslashes would break the LABEL instruction.
    desc=$(printf '%s' "$desc" | tr -d '"\\' | tr '\n' ' ')
    if [ "$s" = running ]; then
        # Flush writes, then freeze every process for the commit so the image
        # is a single point in time instead of files caught mid-write.
        podman exec "$NAME" sync || true
        pause=true
    fi
    echo "saving $NAME ($s) as snapshot '$name'..." >&2
    # Runtime env (VNC_PASSWORD, proxy settings) is cleared: it does not travel
    # with exports, and `up` sets it again for the new container's network mode.
    podman commit -q --pause="$pause" \
        -c 'ENV VNC_PASSWORD=""' \
        -c 'ENV CCU_EGRESS_PROXY="" http_proxy="" https_proxy="" HTTP_PROXY="" HTTPS_PROXY="" no_proxy="" NO_PROXY="" all_proxy="" ALL_PROXY=""' \
        -c "LABEL containercomp.target=\"$TARGET\"" \
        -c 'LABEL containercomp.egress=""' \
        -c "LABEL containercomp.snapshot=\"$name\"" \
        -c "LABEL containercomp.snapshot.base=\"$IMAGE\"" \
        -c "LABEL containercomp.snapshot.parent=\"$(snap_from)\"" \
        -c "LABEL containercomp.snapshot.created=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" \
        -c "LABEL containercomp.snapshot.description=\"$desc\"" \
        "$NAME" "$ref" >/dev/null
    # Drop the replaced image unless a container still uses it.
    [ -z "$old" ] || podman rmi "$old" >/dev/null 2>&1 || true
    echo "saved snapshot '$name' ($ref)"
    echo "start from it with: ccu${TARGET_FLAG} reset --from $name"
}

snap_list() {
    ensure_machine
    local names cur n ref mark
    names=$(snap_names)
    if [ -z "$names" ]; then
        echo "no snapshots of $IMAGE (create one with: ccu${TARGET_FLAG} snapshot save NAME)"
        return 0
    fi
    cur=$(snap_from)
    printf '  %-24s %-21s %-9s %s\n' NAME CREATED SIZE DESCRIPTION
    for n in $names; do
        ref=$(snap_ref "$n")
        mark=" "
        [ "$n" != "$cur" ] || mark="*"
        printf '%s %-24s %-21s %-9s %s\n' "$mark" "$n" \
            "$(podman image inspect -f '{{index .Labels "containercomp.snapshot.created"}}' "$ref")" \
            "$(podman images --format '{{.Size}}' "$ref" | head -n 1)" \
            "$(podman image inspect -f '{{index .Labels "containercomp.snapshot.description"}}' "$ref")"
    done
    [ -z "$cur" ] || echo "* = container '$NAME' was created from this snapshot"
}

snap_rm() {
    [ $# -gt 0 ] || die "usage: ccu snapshot rm NAME..."
    ensure_machine
    local n
    for n in "$@"; do snap_require "$n"; done
    for n in "$@"; do
        podman rmi "$(snap_ref "$n")" >/dev/null \
            || die "could not remove snapshot '$n'; if container '$NAME' uses it, run 'ccu${TARGET_FLAG} reset --base' or 'ccu${TARGET_FLAG} rm' first"
        echo "removed snapshot '$n'"
    done
}

snap_export() {
    [ $# -eq 2 ] || die "usage: ccu snapshot export NAME FILE.tar"
    ensure_machine
    snap_require "$1"
    echo "exporting snapshot '$1' to $2 (includes the base image layers)..." >&2
    podman save -q -o "$2" "$(snap_ref "$1")"
    echo "exported $2 ($(du -h "$2" | cut -f1))"
}

snap_import() {
    [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: ccu snapshot import FILE.tar [NAME]"
    [ -f "$1" ] || die "no such file: $1"
    ensure_machine
    local out loaded name ref arch
    out=$(podman load -i "$1") || die "podman load failed for $1"
    loaded=$(printf '%s\n' "$out" | sed -n 's/^Loaded image[^:]*: *//p' | head -n 1)
    [ -n "$loaded" ] || die "could not find the loaded image in: $out"
    name=${2:-$(podman image inspect -f '{{index .Labels "containercomp.snapshot"}}' "$loaded")}
    [ -n "$name" ] || die "$1 is not a ccu snapshot; pass a NAME to import it anyway"
    snap_check_name "$name"
    ref=$(snap_ref "$name")
    # Retag under this checkout's base image so list/up/reset find it.
    if [ "$loaded" != "$ref" ]; then
        podman tag "$loaded" "$ref"
        podman untag "$loaded" "$loaded" >/dev/null 2>&1 || true
    fi
    arch=$(podman image inspect -f '{{.Architecture}}' "$ref")
    [ "$arch" = "${PLATFORM#linux/}" ] || echo "warning: snapshot is $arch but target $TARGET is ${PLATFORM#linux/}" >&2
    echo "imported snapshot '$name' ($ref)"
}

cmd_snapshot() {
    local sub=${1:-list}
    [ $# -eq 0 ] || shift
    case "$sub" in
        save) snap_save "$@" ;;
        list|ls) snap_list ;;
        rm) snap_rm "$@" ;;
        export) snap_export "$@" ;;
        import) snap_import "$@" ;;
        *) die "unknown snapshot command '$sub' (save, list, rm, export, import)" ;;
    esac
}

# Recreate the container from the snapshot it came from, another one
# (--from NAME), or the base image (--base). Validates before deleting.
cmd_reset() {
    local from="" set=0 keep="" egress_args=() filtered=
    while [ $# -gt 0 ]; do
        case "$1" in
            --from) from=${2:-}; set=1; shift; [ $# -eq 0 ] || shift; snap_check_name "$from" ;;
            --from=*) from=${1#*=}; set=1; shift; snap_check_name "$from" ;;
            --base) from=""; set=1; shift ;;
            --egress) [ $# -ge 2 ] || die "usage: ccu reset --egress FILE"; egress_args=(--egress "$2"); shift 2 ;;
            --egress=*|--offline) egress_args=("$1"); shift ;;
            --upstream) [ $# -ge 2 ] || die "usage: ccu reset --upstream URL|none"; egress_upstream_arg "$2"; shift 2 ;;
            --upstream=*) egress_upstream_arg "${1#*=}"; shift ;;
            *) die "usage: ccu reset [--from NAME | --base] [--egress FILE | --offline] [--upstream URL|none]" ;;
        esac
    done
    ensure_machine
    [ "$set" = 1 ] || from=$(snap_from)
    if [ -n "$from" ]; then snap_require "$from"; fi
    # A filtered desktop stays filtered: carry its current allowlist over unless
    # a new one was given.
    if [ "$(state)" != missing ] && [ -n "$(egress_label)" ] && [ "$(egress_state)" != missing ]; then
        filtered=1
    fi
    if [ "${#egress_args[@]}" -eq 0 ] && [ -z "$EGRESS_REQ" ] && [ -n "$filtered" ]; then
        keep=$(mktemp "${TMPDIR:-/tmp}/ccu-egress-keep.XXXXXX")
        podman cp "$PROXY:/etc/squid/allowlist.txt" "$keep"
        egress_args=(--egress "$keep")
    fi
    # Settle the upstream proxy now, so a bad URL fails before anything is
    # deleted. One given explicitly (--upstream, CCU_UPSTREAM_PROXY) is kept;
    # one from the host's proxy env is looked up again, as for `up`.
    if [ "${#egress_args[@]}" -gt 0 ] || [ -n "$EGRESS_REQ" ]; then
        if [ -z "$EGRESS_UPSTREAM_FROM" ] && [ -n "$filtered" ]; then egress_upstream_keep; fi
        [ -n "$EGRESS_UPSTREAM_DIR" ] || egress_upstream_write
    elif [ "$EGRESS_UPSTREAM_FROM" = --upstream ]; then
        die "--upstream is for filtered desktops; add --egress FILE or --offline"
    fi
    if [ "$(state)" != missing ]; then
        local old
        old=$(podman container inspect -f '{{.Image}}' "$NAME")
        podman rm -f "$NAME" >/dev/null
        echo "removed $NAME" >&2
        # A snapshot replaced with save --force stays behind untagged while in use.
        if [ -n "$(podman image inspect -f '{{index .Labels "containercomp.snapshot"}}' "$old" 2>/dev/null)" ] \
            && [ "$(podman image inspect -f '{{len .RepoTags}}' "$old")" = 0 ]; then
            podman rmi "$old" >/dev/null 2>&1 || true
        fi
    fi
    if [ -n "$from" ]; then set -- --from "$from"; else set --; fi
    if [ "${#egress_args[@]}" -gt 0 ]; then set -- "$@" "${egress_args[@]}"; fi
    if [ $# -gt 0 ]; then cmd_up "$@"; else cmd_up; fi
    if [ -n "$keep" ]; then rm -f "$keep"; fi
}

# --- egress filtering ---------------------------------------------------------
# `up --egress FILE` / `up --offline` put the desktop on an --internal podman
# network (no DNS, no route out) together with a small squid container that is
# also on the default network and forwards only to allowlisted domains. Both
# sit outside the desktop, so root inside it can't loosen them. Offline is the
# same setup with an empty allowlist.

EGRESS_ARGS=()
EGRESS_REQ=${CCU_EGRESS:-}   # FILE, "offline", or empty (keep / unrestricted)
EGRESS_LIST=""               # normalized allowlist for this run (temp file)
EGRESS_HOST=ccu-egress       # the proxy's name inside the desktop (/etc/hosts)
# Upstream proxy for the egress proxy: URL or "none", and where it came from
# (--upstream, CCU_UPSTREAM_PROXY, a host proxy variable, or empty: not set).
EGRESS_UPSTREAM_REQ=${CCU_UPSTREAM_PROXY:-}
EGRESS_UPSTREAM_FROM=${CCU_UPSTREAM_PROXY:+CCU_UPSTREAM_PROXY}
EGRESS_UPSTREAM_DIR=""       # temp dir with upstream.conf (may hold a password) and upstream.info

egress_names() {
    PROXY=$NAME-egress
    EGRESS_NET=$NAME-internal
    EGRESS_IMAGE=${CCU_EGRESS_IMAGE:-localhost/containercomp-egress:latest}
}

egress_state() { podman container inspect -f '{{.State.Status}}' "$PROXY" 2>/dev/null || echo missing; }

# "on" if the desktop was created with egress filtering, empty otherwise.
egress_label() {
    podman container inspect -f '{{index .Config.Labels "containercomp.egress"}}' "$NAME" 2>/dev/null || true
}

egress_build() {
    echo "building $EGRESS_IMAGE (egress proxy)" >&2
    # Like cmd_build: apk needs the host's proxy and CAs on corporate networks.
    local ca
    ca=$(ca_bundle)
    proxy_opts --build-arg
    [ -z "$ca" ] || PROXY_OPTS+=(--build-arg "CCU_EXTRA_CA=$ca")
    podman build ${PROXY_OPTS[@]+"${PROXY_OPTS[@]}"} -t "$EGRESS_IMAGE" -f "$REPO/egress/Containerfile" "$REPO/egress"
}

# Print FILE as squid dstdomain lines: lowercase, "*.x" -> ".x", sorted, and
# without entries that a wildcard already covers. Dies on malformed lines.
egress_normalize() {
    [ -f "$1" ] || die "allowlist file '$1' not found"
    local entries bad
    entries=$(sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | tr 'A-Z' 'a-z')
    bad=$(printf '%s\n' "$entries" \
        | grep -vE '^$|^(\*?\.)?[a-z0-9_]([a-z0-9_-]*[a-z0-9])?(\.[a-z0-9_]([a-z0-9_-]*[a-z0-9])?)*$' || true)
    [ -z "$bad" ] || die "bad allowlist entries in $1: $(printf '%s' "$bad" | tr '\n' ' ')
(one host name per line: example.com, *.example.com or .example.com; no URLs or ports)"
    printf '%s\n' "$entries" | sed 's/^\*\././' | egress_dedupe
}

# Sort squid dstdomain lines (stdin) and drop the ones a ".domain" entry
# already covers: squid rejects such overlaps.
egress_dedupe() {
    sort -u | awk '
        NF { e[++n] = $0 }
        END {
            for (i = 1; i <= n; i++) {
                x = e[i]; covered = 0
                for (j = 1; j <= n; j++) {
                    w = e[j]
                    if (i == j || substr(w, 1, 1) != ".") continue
                    if (x == substr(w, 2) || (length(x) > length(w) && substr(x, length(x) - length(w) + 1) == w)) covered = 1
                }
                if (!covered) print x
            }
        }'
}

# Turn a request (FILE or "offline") into $EGRESS_LIST.
egress_load() {
    EGRESS_LIST=$(mktemp "${TMPDIR:-/tmp}/ccu-egress.XXXXXX")
    trap egress_cleanup EXIT
    if [ "$1" != offline ]; then
        egress_normalize "$1" > "$EGRESS_LIST"
    fi
    chmod 0644 "$EGRESS_LIST"
}

egress_parse_up() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --egress) [ $# -ge 2 ] || die "usage: ccu up --egress FILE"; EGRESS_REQ=$2; shift 2 ;;
            --egress=*) EGRESS_REQ=${1#*=}; shift ;;
            --offline) EGRESS_REQ=offline; shift ;;
            --upstream) [ $# -ge 2 ] || die "usage: ccu up --upstream URL|none"; egress_upstream_arg "$2"; shift 2 ;;
            --upstream=*) egress_upstream_arg "${1#*=}"; shift ;;
            *) die "unknown option for up: $1 (see: ccu help)" ;;
        esac
    done
    if [ -n "$EGRESS_REQ" ]; then egress_load "$EGRESS_REQ"; fi
}

# Copy $EGRESS_LIST into the proxy; a running squid re-reads it on SIGHUP.
egress_apply() {
    local n
    podman cp "$EGRESS_LIST" "$PROXY:/etc/squid/allowlist.txt"
    if [ "$(egress_state)" = running ]; then
        podman kill -s HUP "$PROXY" >/dev/null
    fi
    n=$(grep -c . "$EGRESS_LIST" || true)
    if [ "$n" = 0 ]; then echo "egress: offline, nothing is allowed" >&2
    else echo "egress: $n allowlisted domain(s)" >&2; fi
}

# --- upstream proxy: the egress proxy's own way out ---------------------------
# Where only an explicit (corporate) proxy reaches the internet, squid forwards
# allowed requests to it as a cache_peer parent, CONNECT included, and still
# applies the allowlist itself. Hosts in the host's NO_PROXY, and the Mac
# (host.containers.internal), go direct. The proxy's password, if any, is only
# in /etc/squid/upstream.conf inside the egress container (0640 root:squid);
# upstream.info has the same settings without credentials for status/reset.

egress_cleanup() { rm -rf "$EGRESS_LIST" "$EGRESS_UPSTREAM_DIR"; }

egress_upstream_arg() { EGRESS_UPSTREAM_REQ=$1; EGRESS_UPSTREAM_FROM=--upstream; }

egress_upstream_dir() {
    [ -z "$EGRESS_UPSTREAM_DIR" ] || return 0
    EGRESS_UPSTREAM_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ccu-upstream.XXXXXX")
    trap egress_cleanup EXIT
}

# Without --upstream or CCU_UPSTREAM_PROXY: the host's proxy, as the desktop
# would get it without egress filtering (HTTPS first: most traffic is CONNECT).
egress_upstream_pick() {
    [ -z "$EGRESS_UPSTREAM_FROM" ] && [ "${CCU_PROXY:-1}" != 0 ] || return 0
    local v
    for v in https_proxy HTTPS_PROXY http_proxy HTTP_PROXY; do
        if [ -n "${!v:-}" ]; then EGRESS_UPSTREAM_REQ=${!v}; EGRESS_UPSTREAM_FROM=$v; return 0; fi
    done
}

# Write upstream.conf and upstream.info for the picked upstream into
# $EGRESS_UPSTREAM_DIR. Error messages never repeat the URL (it may hold a
# password).
egress_upstream_write() {
    egress_upstream_pick
    egress_upstream_dir
    local url=$EGRESS_UPSTREAM_REQ from=$EGRESS_UPSTREAM_FROM rest auth="" host port e np="" doms="" nets="" user=""
    local conf=$EGRESS_UPSTREAM_DIR/upstream.conf info=$EGRESS_UPSTREAM_DIR/upstream.info
    if [ "${CCU_PROXY:-1}" != 0 ]; then np=${no_proxy:-${NO_PROXY:-}}; fi
    # NO_PROXY=* means "never use the proxy", unless one was given explicitly.
    case "$from:,$np," in --upstream:*|CCU_UPSTREAM_PROXY:*) ;; *:*,\*,*) url="" ;; esac
    case "$url" in
        ""|none|direct) url="" ;;
        [Hh][Tt][Tt][Pp]://*) rest=${url#*://} ;;
        *://*) die "upstream proxy ($from): only http:// proxies are supported, not ${url%%://*}://" ;;
        *) rest=$url ;;
    esac
    : > "$conf"
    chmod 0600 "$conf"
    if [ -z "$url" ]; then
        printf '%s\n' "# Written by ccu: no upstream proxy, connect directly." "http_access deny to_localhost" > "$conf"
        printf 'upstream=\nfrom=%s\n' "$from" > "$info"
        return 0
    fi
    case "$rest" in *@*) auth=${rest%@*}; rest=${rest##*@} ;; esac
    rest=${rest%%/*}
    case "$rest" in
        "[::1]") rest=localhost ;;
        "[::1]:"*) rest=localhost:${rest#"[::1]:"} ;;
    esac
    host=$(printf '%s' "${rest%%:*}" | tr 'A-Z' 'a-z')
    port=80
    case "$rest" in *:?*) port=${rest#*:} ;; esac
    # The proxy on the Mac's loopback is host.containers.internal from a container.
    case "$host" in localhost|127.0.0.1) host=host.containers.internal ;; esac
    if ! printf '%s\n' "$host" | grep -qE '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$' \
        || ! printf '%s\n' "$port" | grep -qE '^[0-9]{1,5}$' || [ "$port" -gt 65535 ]; then
        die "upstream proxy ($from): expected http://[user:password@]host[:port]"
    fi
    # squid URL-unescapes login=, so a percent-encoded URL password works as is.
    case "$auth" in
        *[[:space:][:cntrl:]]*) die "upstream proxy ($from): percent-encode spaces in the user name or password (%20)" ;;
        "") ;;
        *:*) user=yes ;;
        *) user=yes; auth=$auth: ;;
    esac
    # NO_PROXY: "corp.example" and ".corp.example" cover the domain and its
    # subdomains (as in curl); IPv4 addresses and CIDR ranges match IP-literal
    # requests. Ports are dropped; other entries (IPv6, "*") are ignored.
    while IFS= read -r e; do
        e=$(printf '%s' "$e" | tr -d '[:space:]' | tr 'A-Z' 'a-z')
        e=${e#\*}
        case "$e" in
            ""|.) ;;
            */*)
                if printf '%s\n' "$e" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$'; then nets="$nets $e"; fi ;;
            *)
                e=${e%:[0-9]*}
                if printf '%s\n' "$e" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then doms="$doms$e
"
                elif printf '%s\n' "$e" | grep -qE '^\.?[a-z0-9_]([a-z0-9_-]*[a-z0-9])?(\.[a-z0-9_]([a-z0-9_-]*[a-z0-9])?)*$'; then
                    doms="$doms.${e#.}
"
                fi ;;
        esac
    done <<< "$(printf '%s\n' "$np" | tr ',' '\n')"
    doms=$(printf '%s' "$doms" | egress_dedupe | tr '\n' ' ')
    {
        echo "# Written by ccu: allowed requests go through the upstream proxy"
        echo "# http://$host:$port (from $from); NO_PROXY hosts and the Mac go direct."
        echo 'acl ccu_iplit dstdom_regex -n ^[0-9.]+$|:'
        printf '%s\n' "acl ccu_direct dstdomain -n $(printf 'localhost\n127.0.0.1\nhost.containers.internal\n%s' "$doms" | tr ' ' '\n' | egress_dedupe | tr '\n' ' ')"
        if [ -n "$nets" ]; then echo "acl ccu_direct_net dst$nets"; fi
        # Only connections squid makes itself need the loopback check (and its
        # DNS lookup); the upstream resolves everything else.
        echo "http_access deny ccu_iplit to_localhost"
        echo "http_access deny ccu_direct to_localhost"
        printf '%s\n' "cache_peer $host parent $port 0 no-query no-digest no-netdb-exchange default name=ccu_upstream${auth:+ login=$auth}"
        echo "always_direct allow ccu_direct"
        if [ -n "$nets" ]; then echo "always_direct allow ccu_iplit ccu_direct_net"; fi
        echo "never_direct allow all"
    } > "$conf"
    printf 'upstream=http://%s:%s\nauth=%s\nfrom=%s\ndirect=%s\n' "$host" "$port" "${user:-no}" "$from" \
        "$(echo $doms$nets)" > "$info"
}

# reset: copy the old proxy's upstream files if they were set explicitly.
egress_upstream_keep() {
    local from
    from=$( (egress_cat /etc/squid/upstream.info || true) | sed -n 's/^from=//p')
    case "$from" in --upstream|CCU_UPSTREAM_PROXY) ;; *) return 0 ;; esac
    egress_upstream_dir
    podman cp "$PROXY:/etc/squid/upstream.conf" "$EGRESS_UPSTREAM_DIR/upstream.conf"
    podman cp "$PROXY:/etc/squid/upstream.info" "$EGRESS_UPSTREAM_DIR/upstream.info"
}

egress_upstream_copy() {
    podman cp "$EGRESS_UPSTREAM_DIR/upstream.conf" "$PROXY:/etc/squid/upstream.conf"
    podman cp "$EGRESS_UPSTREAM_DIR/upstream.info" "$PROXY:/etc/squid/upstream.info"
    # A stopped proxy gets this from its entrypoint.
    if [ "$(egress_state)" = running ]; then
        podman exec "$PROXY" chown root:squid /etc/squid/upstream.conf
        podman exec "$PROXY" chmod 0640 /etc/squid/upstream.conf
    fi
}

# `up --upstream` on an existing filtered desktop: switch its proxy over.
egress_upstream_update() {
    egress_cat /etc/squid/squid.conf | grep -q upstream.conf \
        || die "egress proxy '$PROXY' predates upstream proxy support; recreate it with: ccu${TARGET_FLAG} egress build && ccu${TARGET_FLAG} reset --upstream URL"
    egress_upstream_write
    egress_upstream_note
    if [ "$(egress_state)" = running ]; then
        [ "$(podman exec "$PROXY" cksum /etc/squid/upstream.conf | cut -d' ' -f1-2)" \
            != "$(cksum "$EGRESS_UPSTREAM_DIR/upstream.conf" | cut -d' ' -f1-2)" ] || return 0
        egress_upstream_copy
        # Restart rather than reconfigure: squid would reuse connections it
        # opened to the old upstream.
        podman restart -t 2 "$PROXY" >/dev/null
    else
        egress_upstream_copy
    fi
}

egress_upstream_note() {
    if grep -q '^upstream=.' "$EGRESS_UPSTREAM_DIR/upstream.info" || grep -q '^from=.' "$EGRESS_UPSTREAM_DIR/upstream.info"; then
        echo "egress: upstream $(egress_upstream_desc < "$EGRESS_UPSTREAM_DIR/upstream.info")" >&2
    fi
}

# Describe an upstream.info (stdin) in one line; it has no credentials.
egress_upstream_desc() {
    awk '{ k = $0; sub(/=.*/, "", k); v = $0; sub(/^[^=]*=/, "", v); a[k] = v }
        END {
            if (a["upstream"] == "") s = "none (connects directly)"
            else s = a["upstream"] (a["auth"] == "yes" ? " with credentials" : "")
            if (a["from"] != "") s = s ", from " a["from"]
            if (a["direct"] != "") s = s "; direct: " a["direct"]
            print s
        }'
}

# Before `up` touches an existing desktop: a desktop's network mode is fixed at
# creation, so refuse to change it; otherwise update the list and start the proxy.
egress_pre_up() {
    [ "$(state)" != missing ] || return 0
    if [ -z "$(egress_label)" ]; then
        [ -z "$EGRESS_REQ" ] && [ "$EGRESS_UPSTREAM_FROM" != --upstream ] \
            || die "'$NAME' was created without egress filtering; recreate it (this discards its state) with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
        return 0
    fi
    [ "$(egress_state)" != missing ] || die "egress proxy '$PROXY' is missing; recreate the desktop with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
    if [ -n "$EGRESS_REQ" ]; then egress_apply; fi
    # An explicit upstream replaces the current one; the host's proxy env only
    # counts when the desktop is created.
    if [ -n "$EGRESS_UPSTREAM_FROM" ]; then egress_upstream_update; fi
    [ "$(egress_state)" = running ] || podman start "$PROXY" >/dev/null
}

# For a new desktop: create the internal network and the proxy, and set
# EGRESS_ARGS for `podman run`. No-op unless egress filtering was requested.
egress_create() {
    if [ -z "$EGRESS_REQ" ]; then
        [ "$EGRESS_UPSTREAM_FROM" != --upstream ] || die "--upstream is for filtered desktops; add --egress FILE or --offline"
        return 0
    fi
    [ -n "$EGRESS_UPSTREAM_DIR" ] || egress_upstream_write
    if grep -q '^upstream=.' "$EGRESS_UPSTREAM_DIR/upstream.info" && podman image exists "$EGRESS_IMAGE" \
        && [ "$(podman image inspect -f '{{index .Labels "containercomp.egress.upstream"}}' "$EGRESS_IMAGE")" != 1 ]; then
        echo "$EGRESS_IMAGE predates upstream proxy support; rebuilding it" >&2
        egress_build
    fi
    podman image exists "$EGRESS_IMAGE" || egress_build
    # Leftovers from a desktop that was removed outside ccu.
    podman rm -f "$PROXY" >/dev/null 2>&1 || true
    if podman network exists "$EGRESS_NET"; then podman network rm "$EGRESS_NET" >/dev/null; fi
    podman network create --internal --disable-dns --label containercomp.egress-for="$NAME" "$EGRESS_NET" >/dev/null
    local subnet base proxy noproxy=localhost,127.0.0.1,::1
    subnet=$(podman network inspect -f '{{range .Subnets}}{{.Subnet}}{{end}}' "$EGRESS_NET")
    case "$subnet" in
        *.0/24) base=${subnet%.0/24} ;;
        *) die "unexpected subnet '$subnet' on $EGRESS_NET (expected a /24)" ;;
    esac
    # Fixed addresses: the network has no DNS, so the desktop reaches the proxy
    # through an /etc/hosts entry.
    podman create --name "$PROXY" --hostname "$PROXY" \
        --network podman --network "$EGRESS_NET:ip=$base.2" \
        --label containercomp.egress-for="$NAME" \
        "$EGRESS_IMAGE" >/dev/null
    egress_upstream_copy
    egress_apply
    podman start "$PROXY" >/dev/null
    egress_upstream_note
    proxy=http://$EGRESS_HOST:3128
    EGRESS_ARGS=(--network "$EGRESS_NET" --ip "$base.3" --dns 127.0.0.1
        --add-host "$EGRESS_HOST:$base.2"
        --cap-drop NET_ADMIN --cap-drop NET_RAW
        -e CCU_EGRESS_PROXY="$proxy"
        -e http_proxy="$proxy" -e https_proxy="$proxy" -e HTTP_PROXY="$proxy" -e HTTPS_PROXY="$proxy"
        -e no_proxy="$noproxy" -e NO_PROXY="$noproxy"
        --label containercomp.egress=on)
}

egress_stop() {
    if [ "$(egress_state)" = running ]; then podman stop -t 2 "$PROXY" >/dev/null && echo "stopped $PROXY"; fi
}

egress_rm() {
    if podman container exists "$PROXY"; then podman rm -f "$PROXY" >/dev/null && echo "removed $PROXY"; fi
    if podman network exists "$EGRESS_NET"; then podman network rm "$EGRESS_NET" >/dev/null && echo "removed network $EGRESS_NET"; fi
}

# Print a file from the proxy container (running or stopped).
egress_cat() {
    local tmp rc=0
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ccu-egress.XXXXXX")
    podman cp "$PROXY:$1" "$tmp/f" >/dev/null 2>&1 && cat "$tmp/f" || rc=1
    rm -rf "$tmp"
    return $rc
}

egress_summary() {
    local n up
    if [ "$(state)" = missing ]; then echo "-"; return; fi
    if [ -z "$(egress_label)" ]; then echo "unrestricted"; return; fi
    n=$(egress_cat /etc/squid/allowlist.txt | grep -c . || true)
    up=$(egress_cat /etc/squid/upstream.info | sed -n 's/^upstream=//p' || true)
    if [ "$n" = 0 ]; then printf 'offline (nothing allowed)'
    else printf 'allowlist (%s domain(s))' "$n"; fi
    if [ -n "$up" ]; then printf ' via upstream %s' "$up"; fi
    echo "; proxy $PROXY ($(egress_state)); blocked requests: ccu${TARGET_FLAG} egress log"
}

egress_log() {
    local follow=0 n=50 pat=_DENIED/
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--follow) follow=1; shift ;;
            --all) pat=.; shift ;;
            -n) [ $# -ge 2 ] || die "usage: ccu egress log -n N"; n=$2; shift 2 ;;
            *) die "usage: ccu egress log [-f] [--all] [-n N]" ;;
        esac
    done
    [ "$(egress_state)" != missing ] || die "'$NAME' has no egress proxy (it was not started with --egress or --offline)"
    if [ "$follow" = 1 ]; then
        [ "$(egress_state)" = running ] || die "egress proxy '$PROXY' is not running; start it with: ccu${TARGET_FLAG} up"
        podman exec "$PROXY" tail -n "$n" -F /var/log/squid/access.log | grep --line-buffered -e "$pat"
    else
        egress_cat /var/log/squid/access.log | grep -e "$pat" | tail -n "$n" || true
    fi
}

cmd_egress() {
    local sub=${1:-status}
    [ $# -eq 0 ] || shift
    case "$sub" in
        status)
            echo "egress:    $(egress_summary)"
            if [ -n "$(egress_label)" ]; then
                echo "upstream:  $( (egress_cat /etc/squid/upstream.info || true) | egress_upstream_desc)"
                egress_cat /etc/squid/allowlist.txt | sed 's/^/  /'
            fi
            ;;
        log) egress_log "$@" ;;
        set)
            [ $# -eq 1 ] || die "usage: ccu egress set FILE|offline"
            [ "$(state)" != missing ] || die "container '$NAME' does not exist; create it with: ccu${TARGET_FLAG} up --egress FILE"
            [ -n "$(egress_label)" ] || die "'$NAME' was created without egress filtering; recreate it with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
            egress_load "$1"
            egress_apply
            ;;
        build) egress_build ;;
        *) die "usage: ccu egress [status | log [-f] [--all] [-n N] | set FILE|offline | build]" ;;
    esac
}

# --- corporate networks: extra CA certificates and proxy passthrough ----------

CERT_DIR=${CCU_CERT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/containercomp/certs}

# Print a cert file as PEM (accepts PEM bundles and DER).
pem_of() {
    if grep -q 'BEGIN CERTIFICATE' "$1"; then cat "$1"
    else openssl x509 -inform DER -in "$1" || die "$1 is not a PEM or DER certificate"; fi
}

# Every extra CA that ccu applies: the stored ones plus CCU_CA_FILE (colon-separated).
ca_bundle() {
    local f
    for f in "$CERT_DIR"/*.pem; do
        if [ -f "$f" ]; then cat "$f"; echo; fi
    done
    if [ -n "${CCU_CA_FILE:-}" ]; then
        local IFS=:
        for f in $CCU_CA_FILE; do
            [ -f "$f" ] || die "CCU_CA_FILE: no such file: $f"
            pem_of "$f"; echo
        done
    fi
}

# Self-signed CA roots that macOS trusts for TLS beyond Apple's built-in roots:
# what an admin, MDM profile or user added (e.g. a Zscaler/Netskope root).
keychain_roots() {
    local tmp f fp builtin
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ccu-certs.XXXXXX")
    builtin=$(security find-certificate -a -Z /System/Library/Keychains/SystemRootCertificates.keychain \
        | awk '/^SHA-256 hash:/ {print $3}')
    {
        security find-certificate -a -p /Library/Keychains/System.keychain
        security list-keychains -d user | sed 's/^ *"//; s/" *$//' | while IFS= read -r f; do
            security find-certificate -a -p "$f"
        done
    } 2>/dev/null | awk -v d="$tmp" '
        /-----BEGIN CERTIFICATE-----/ { n++; f = sprintf("%s/%04d.pem", d, n) }
        f { print > f }
        /-----END CERTIFICATE-----/ { close(f); f = "" }'
    for f in "$tmp"/*.pem; do
        [ -f "$f" ] || continue
        openssl x509 -in "$f" -noout -text 2>/dev/null | grep -q 'CA:TRUE' || continue
        openssl x509 -in "$f" -noout -checkend 0 >/dev/null 2>&1 || continue
        [ "$(openssl x509 -in "$f" -noout -subject | sed 's/^subject= *//')" = \
          "$(openssl x509 -in "$f" -noout -issuer | sed 's/^issuer= *//')" ] || continue
        fp=$(openssl x509 -in "$f" -noout -fingerprint -sha256 | sed 's/.*=//; s/://g')
        case "$builtin" in *"$fp"*) continue ;; esac
        # Trusted per the admin/user trust settings (offline). The ssl policy alone
        # rejects public roots over CT, so it is only a fallback for roots
        # trusted for SSL only.
        security verify-cert -q -L -l -R offline -p basic -c "$f" >/dev/null 2>&1 \
            || security verify-cert -q -L -l -R offline -p ssl -c "$f" >/dev/null 2>&1 || continue
        cat "$f"
    done
    rm -rf "$tmp"
}

# Run the in-container helper as root with the CA bundle on stdin. Containers
# from images that predate it get a copy.
netsetup() {
    podman exec "$NAME" test -x /opt/ccu/bin/netsetup \
        || podman cp "$REPO/rootfs/opt/ccu/bin/netsetup" "$NAME:/opt/ccu/bin/netsetup"
    ca_bundle | podman exec -i "$NAME" /opt/ccu/bin/netsetup "$1"
}

# Rewrite a proxy URL whose host is the Mac's loopback: inside the container
# that host is host.containers.internal.
container_url() {
    printf '%s\n' "$1" | sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)?([^@/]*@)?(localhost|127\.0\.0\.1|\[::1\])([:/]|$)#\1\2host.containers.internal\4#'
}

# Host proxy env as podman options in PROXY_OPTS; $1 is -e or --build-arg.
# Both spellings are set because tools disagree on which one they read.
proxy_opts() {
    PROXY_OPTS=()
    if [ "${CCU_PROXY:-1}" = 0 ]; then PROXY_OPTS=(--http-proxy=false); return 0; fi
    local v V val any=0
    for v in http_proxy https_proxy all_proxy no_proxy; do
        V=$(echo "$v" | tr a-z A-Z)
        val=${!v:-${!V:-}}
        if [ "$v" = no_proxy ]; then
            [ "$any" = 1 ] || continue
            val=${val:+$val,}localhost,127.0.0.1,::1,host.containers.internal
        else
            [ -n "$val" ] || continue
            any=1
            val=$(container_url "$val")
        fi
        PROXY_OPTS+=("$1" "$v=$val" "$1" "$V=$val")
    done
}

# Opt-in only: trust the same CAs in the podman machine VM, so `podman pull`
# works behind the proxy. It changes the VM, which all containers share.
machine_certs() {
    [ "$(uname -s)" = Darwin ] || die "--machine is for the podman machine VM on macOS; on Linux, add the CA to the host trust store"
    local n anchor=/etc/pki/ca-trust/source/anchors/containercomp.pem
    n=$(ca_bundle | grep -c 'BEGIN CERTIFICATE' || true)
    if [ "$n" -gt 0 ]; then
        ca_bundle | podman machine ssh "sudo tee $anchor >/dev/null && sudo update-ca-trust"
        echo "podman machine: trusting $n extra CA certificate(s) ($anchor)"
    else
        podman machine ssh "sudo rm -f $anchor && sudo update-ca-trust"
        echo "podman machine: removed $anchor"
    fi
    echo "if podman pull still fails with certificate errors, restart the VM (stops every container):"
    echo "  podman machine stop && podman machine start"
}

certs_show() {
    echo "  $1"
    pem_of "$2" | openssl crl2pkcs7 -nocrl -certfile /dev/stdin \
        | openssl pkcs7 -print_certs -noout | sed -n 's/^subject= */    /p'
}

cmd_certs() {
    local sub=${1:-list} machine=0 a f args=()
    [ $# -eq 0 ] || shift
    for a in "$@"; do
        if [ "$a" = --machine ]; then machine=1; else args+=("$a"); fi
    done
    set -- ${args[@]+"${args[@]}"}
    case "$sub" in
        sync)
            [ "$(uname -s)" = Darwin ] || die "certs sync reads the macOS keychains; elsewhere use: ccu certs add FILE.pem"
            mkdir -p "$CERT_DIR"; f=$CERT_DIR/macos-keychain.pem
            keychain_roots > "$f.tmp"
            if [ -s "$f.tmp" ]; then
                mv "$f.tmp" "$f"
                echo "macOS keychains: $(grep -c 'BEGIN CERTIFICATE' "$f") extra trusted root(s) -> $f"
            else
                rm -f "$f.tmp" "$f"
                echo "macOS keychains: no trusted roots beyond Apple's built-in ones"
            fi
            ;;
        add)
            [ $# -ge 1 ] && [ -f "$1" ] || die "usage: ccu certs add FILE.pem|FILE.crt|FILE.der [NAME]"
            mkdir -p "$CERT_DIR"; f=$CERT_DIR/${2:-$(basename "${1%.*}")}.pem
            pem_of "$1" > "$f.tmp"
            grep -q 'BEGIN CERTIFICATE' "$f.tmp" || { rm -f "$f.tmp"; die "no certificate found in $1"; }
            mv "$f.tmp" "$f"
            echo "added $f"
            ;;
        rm)
            [ $# -ge 1 ] || die "usage: ccu certs rm NAME (see: ccu certs list)"
            [ -f "$CERT_DIR/${1%.pem}.pem" ] || die "no such cert: $1 (see: ccu certs list)"
            rm "$CERT_DIR/${1%.pem}.pem"
            echo "removed $1"
            ;;
        list)
            echo "extra CAs in $CERT_DIR:"
            for f in "$CERT_DIR"/*.pem; do
                if [ -s "$f" ]; then certs_show "$(basename "${f%.pem}")" "$f"; fi
            done
            if [ -n "${CCU_CA_FILE:-}" ]; then
                local IFS=:
                for f in $CCU_CA_FILE; do certs_show "$f (CCU_CA_FILE)" "$f"; done
            fi
            return 0
            ;;
        apply) ;;
        *) die "usage: ccu certs sync|add|rm|list|apply [--machine]" ;;
    esac
    if [ "$(state)" = running ]; then netsetup certs
    else echo "'$NAME' is not running; the certs apply at the next: ccu${TARGET_FLAG} up"; fi
    if [ "$machine" = 1 ]; then machine_certs; fi
}

# --- main ---------------------------------------------------------------------

TARGET_FLAG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target) TARGET=$2; TARGET_FLAG=" -t $2"; shift 2 ;;
        --target=*) TARGET=${1#*=}; TARGET_FLAG=" -t ${1#*=}"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done
set_target
[ "$AUDIT_MIRROR" != default ] || AUDIT_MIRROR=${XDG_STATE_HOME:-$HOME/.local/state}/ccu/audit/$NAME.jsonl
egress_names
[ $# -gt 0 ] || { usage; exit 1; }
cmd=$1; shift

# --shot: screenshot after a control command.
SHOT=0
if [ $# -gt 0 ]; then
    rest=()
    for a in "$@"; do
        if [ "$a" = --shot ]; then SHOT=1; else rest+=("$a"); fi
    done
    set -- ${rest[@]+"${rest[@]}"}
fi

case "$cmd" in
    help) usage ;;
    build) cmd_build ;;
    up|start) cmd_up "$@" ;;
    down|stop) podman stop -t 5 "$NAME" >/dev/null && echo "stopped $NAME"; egress_stop ;;
    rm) podman rm -f "$NAME" >/dev/null && echo "removed $NAME"; egress_rm ;;
    reset) cmd_reset "$@" ;;
    snapshot|snap) cmd_snapshot "$@" ;;
    status) cmd_status ;;
    open) require_running; open "http://localhost:$PORT/" ;;
    logs)
        require_running
        if [ $# -gt 0 ]; then podman exec "$NAME" tail -n 200 "/var/log/ccu/$1.log"
        else podman logs --tail 200 "$NAME"; fi
        ;;
    shell)
        require_running
        audit_note shell "root=$([ "${1:-}" = --root ] && echo 1 || echo 0)"
        if [ "${1:-}" = --root ]; then podman exec -it -e DISPLAY=:1 "$NAME" bash
        else podman exec -it -u user -w /home/user -e DISPLAY=:1 "$NAME" bash -l; fi
        ;;
    exec)
        require_running
        if [ "${1:-}" = --root ]; then shift; pexec cu exec --root -- "$@"
        else pexec cu exec -- "$@"; fi
        ;;
    mcp)
        # Don't auto-start: Claude Code spawns MCP servers at every session start.
        require_running
        set -- podman exec -i -u user -w /home/user -e DISPLAY=:1 "${AUDIT_ENV[@]}" "$NAME" /opt/ccu/venv/bin/python /opt/ccu/mcp_server.py
        if [ "$AUDIT_MIRROR" = off ]; then exec "$@"; fi
        exec "$@" 2> >(audit_tee)
        ;;
    egress) cmd_egress "$@" ;;
    install) require_running; cmd_install "$@" ;;
    cp-in) require_running; cmd_cp_in "$@" ;;
    cp-out) require_running; cmd_cp_out "$@" ;;
    certs) cmd_certs "$@" ;;
    screenshot) require_running; cmd_screenshot "$@" ;;
    zoom) require_running; cmd_zoom "$@" ;;
    audit) require_running; cmd_audit "$@" ;;
    record) require_running; cmd_record "$@" ;;
    click|double_click|triple_click|right_click|middle_click|move|mouse_down|mouse_up|drag|scroll|type|key|launch|focus|wait_window|wait|windows|active|size|cursor)
        require_running
        pexec cu "$cmd" "$@"
        if [ "$SHOT" = 1 ]; then
            sleep 0.6
            cmd_screenshot
        fi
        ;;
    *) die "unknown command '$cmd' (see: ccu help)" ;;
esac
