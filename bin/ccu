#!/bin/bash
# ccu: run and control the containercomp desktop from the Mac host.
# Run `ccu help` for usage.
set -euo pipefail

# Resolve the repo root through symlinks (macOS bash 3.2 has no readlink -f guarantee).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
REPO=$(cd -P "$(dirname "$src")/.." && pwd)

TARGET=${CCU_TARGET:-native}
SHOT_DIR=${CCU_SHOT_DIR:-${TMPDIR:-/tmp}/ccu}
SCREEN=${CCU_SCREEN:-1280x800}

usage() {
    cat <<'EOF'
ccu: a Linux desktop in a Podman container, driven by mouse/keyboard/screenshots.

usage: ccu [-t native|x86] <command> [args]

  -t native   arm64 Ubuntu desktop (default, fast)
  -t x86      amd64 Ubuntu desktop under emulation, with Wine for Windows apps
              (or set CCU_TARGET=x86)

Lifecycle
  build                 build (or rebuild) the image
  up                    start the desktop (builds the image first if needed)
  up --egress FILE      ...with network access limited to the domains in FILE
  up --offline          ...with no network access at all (see "Network" below)
  down                  stop the container (state is kept)
  rm                    delete the container (state is lost; the image stays)
  status                show container status and the viewer URL
  open                  open the noVNC viewer in your browser
  logs [service]        desktop logs (xvfb, desktop, x11vnc, novnc)
  shell [--root]        interactive shell in the container
  exec [--root] CMD...  run a command in the container
  mcp                   stdio MCP server (for `claude mcp add containercomp -- ccu mcp`)

Apps and files
  install TARGET...     apt package names, URLs, or host files (.deb, .AppImage,
                        .exe/.msi on x86, archives); host files go to ~/apps
  cp-in HOST [DEST]     copy a host file into the container (default ~/apps/)
  cp-out SRC [HOST]     copy a container file to the host (default: current dir)

Screen control (coordinates are screen pixels; screenshot pixels = click pixels)
  screenshot [FILE]     save a PNG, print its path
  zoom X0 Y0 X1 Y1 [--scale N] [FILE]   enlarged crop of a region
  click X Y [--button left|right|middle] [--mods ctrl+shift]
  double_click X Y | triple_click X Y | right_click X Y | middle_click X Y
  move X Y              mouse_down | mouse_up
  drag X0 Y0 X1 Y1
  scroll X Y up|down|left|right [AMOUNT]
  type TEXT             newlines press Return
  key COMBO...          xdotool names: ctrl+s Return Escape Tab alt+F4 super
  launch CMD...         start a GUI app in the background
  windows | active | size | cursor
  focus TITLE           raise the window whose title contains TITLE
  wait_window TITLE [--timeout S]
  wait SECONDS

Add --shot to any control command to take a screenshot afterwards and print its path.

Network (egress allowlist; chosen when the container is created)
  egress [status]       show the mode and the allowlist
  egress log [-f] [--all] [-n N]   blocked requests (--all: allowed ones too)
  egress set FILE|offline          replace the allowlist of a filtered desktop
  FILE has one domain per line: "example.com" allows just that host,
  "*.example.com" or ".example.com" allows it and all subdomains; # comments.
  Only proxy-aware traffic (HTTP_PROXY/HTTPS_PROXY are preset) gets out.

Environment: CCU_TARGET, CCU_SCREEN (default 1280x800), CCU_PORT, CCU_SHOT_DIR,
VNC_PASSWORD (applied when the container is created), CCU_IMAGE, CCU_EGRESS
(FILE or "offline", same as up --egress), CCU_EGRESS_IMAGE.
EOF
}

die() { echo "ccu: $*" >&2; exit 1; }

set_target() {
    case "$TARGET" in
        native|arm64) TARGET=native; PLATFORM=linux/arm64; NAME=${CCU_NAME:-ccu}; PORT=${CCU_PORT:-6080} ;;
        x86|amd64) TARGET=x86; PLATFORM=linux/amd64; NAME=${CCU_NAME:-ccu-x86}; PORT=${CCU_PORT:-6081} ;;
        *) die "unknown target '$TARGET' (use native or x86)" ;;
    esac
    IMAGE=${CCU_IMAGE:-localhost/containercomp:$TARGET}
}

state() { podman container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo missing; }

require_running() {
    [ "$(state)" = running ] || die "container '$NAME' is not running; start it with: ccu${TARGET_FLAG} up"
}

# podman exec as the desktop user with the display env.
pexec() {
    podman exec -u user -w /home/user -e DISPLAY=:1 "$NAME" "$@"
}

ensure_machine() {
    # On macOS podman needs its Linux VM running.
    if [ "$(uname -s)" = Darwin ] && ! podman info >/dev/null 2>&1; then
        echo "starting podman machine..." >&2
        podman machine start >/dev/null 2>&1 || podman machine init --now \
            || die "could not start the podman machine; run 'podman machine init --now' manually"
    fi
}

cmd_build() {
    ensure_machine
    echo "building $IMAGE ($PLATFORM); the x86 build is slow under emulation" >&2
    podman build --platform "$PLATFORM" -t "$IMAGE" -f "$REPO/Containerfile" "$REPO"
}

wait_ready() {
    local i
    for i in $(seq 1 90); do
        if pexec xdotool getdisplaygeometry >/dev/null 2>&1 && pexec test -f /home/user/.cache/ccu/session.env; then
            # Give the panel and window manager a moment to map.
            sleep 2
            return 0
        fi
        sleep 1
    done
    die "desktop did not come up; check: ccu${TARGET_FLAG} logs desktop"
}

check_rosetta() {
    # On Apple Silicon, x86 runs far better (and 64-bit Windows apps only work)
    # with Rosetta, which Podman 5.6+ leaves disabled by default.
    [ "$TARGET" = x86 ] && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || return 0
    podman machine ssh 'test -e /proc/sys/fs/binfmt_misc/rosetta' >/dev/null 2>&1 && return 0
    cat >&2 <<'EOF'
warning: Rosetta is not active in the podman machine, so x86 runs under qemu
(slow, and Wine fails to load most .exe files). On macOS 26+ enable it with:
  podman machine ssh "sudo touch /etc/containers/enable-rosetta"
  podman machine stop && podman machine start
EOF
}

cmd_up() {
    egress_parse_up "$@"
    ensure_machine
    check_rosetta
    egress_pre_up
    case "$(state)" in
        running) ;;
        missing)
            podman image exists "$IMAGE" || cmd_build
            egress_create
            local w=${SCREEN%x*} h=${SCREEN#*x}
            podman run -d --name "$NAME" --hostname "$NAME" \
                --platform "$PLATFORM" \
                -p "127.0.0.1:$PORT:6080" \
                --shm-size 2g \
                -e SCREEN_WIDTH="$w" -e SCREEN_HEIGHT="$h" \
                -e VNC_PASSWORD="${VNC_PASSWORD:-}" \
                --label containercomp.target="$TARGET" \
                ${EGRESS_ARGS[@]+"${EGRESS_ARGS[@]}"} \
                "$IMAGE" >/dev/null
            ;;
        *) podman start "$NAME" >/dev/null ;;
    esac
    wait_ready
    echo "desktop '$NAME' is up: $(pexec cu size | tr ' ' x) at http://localhost:$PORT/"
}

cmd_status() {
    local s
    s=$(state)
    echo "target:    $TARGET ($PLATFORM)"
    echo "container: $NAME ($s)"
    echo "image:     $IMAGE ($(podman image exists "$IMAGE" && echo present || echo 'not built'))"
    echo "egress:    $(egress_summary)"
    if [ "$s" = running ]; then
        echo "viewer:    http://localhost:$PORT/"
        echo "screen:    $(pexec cu size | tr ' ' x)"
        echo "windows:"
        pexec cu windows | sed 's/^/  /'
    fi
}

new_shot_path() {
    mkdir -p "$SHOT_DIR"
    echo "$SHOT_DIR/$NAME-$(date +%Y%m%d-%H%M%S)-$$-$RANDOM.png"
}

cmd_screenshot() {
    local out=${1:-$(new_shot_path)}
    pexec cu screenshot > "$out"
    [ -s "$out" ] || die "screenshot failed"
    echo "$out"
}

cmd_zoom() {
    local args=() out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --scale) args+=("$1" "$2"); shift 2 ;;
            *.png) out=$1; shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ -n "$out" ] || out=$(new_shot_path)
    pexec cu zoom "${args[@]}" > "$out"
    [ -s "$out" ] || die "zoom failed"
    echo "$out"
}

cmd_install() {
    [ $# -gt 0 ] || die "usage: ccu install <apt-package|url|host-file>..."
    local targets=() a dest
    for a in "$@"; do
        if [ -f "$a" ]; then
            dest=/home/user/apps/$(basename "$a")
            podman exec "$NAME" mkdir -p /home/user/apps
            podman cp "$a" "$NAME:$dest"
            podman exec "$NAME" chown user:user /home/user/apps "$dest"
            targets+=("$dest")
        else
            targets+=("$a")
        fi
    done
    podman exec -e DISPLAY=:1 "$NAME" /usr/local/bin/ccu-install "${targets[@]}"
}

cmd_cp_in() {
    [ $# -ge 1 ] || die "usage: ccu cp-in HOST_PATH [CONTAINER_DEST]"
    local dest=${2:-/home/user/apps/}
    podman exec "$NAME" mkdir -p /home/user/apps
    podman cp "$1" "$NAME:$dest"
    podman exec "$NAME" chown -R user:user /home/user/apps
    case "$dest" in /home/user/*) podman exec "$NAME" chown -R user:user "$dest" ;; esac
    echo "copied to $dest"
}

cmd_cp_out() {
    [ $# -ge 1 ] || die "usage: ccu cp-out CONTAINER_PATH [HOST_DEST]"
    local src=$1
    case "$src" in /*) ;; *) src=/home/user/$src ;; esac
    podman cp "$NAME:$src" "${2:-.}"
}

# --- egress filtering ---------------------------------------------------------
# `up --egress FILE` / `up --offline` put the desktop on an --internal podman
# network (no DNS, no route out) together with a small squid container that is
# also on the default network and forwards only to allowlisted domains. Both
# sit outside the desktop, so root inside it can't loosen them. Offline is the
# same setup with an empty allowlist.

EGRESS_ARGS=()
EGRESS_REQ=${CCU_EGRESS:-}   # FILE, "offline", or empty (keep / unrestricted)
EGRESS_LIST=""               # normalized allowlist for this run (temp file)
EGRESS_HOST=ccu-egress       # the proxy's name inside the desktop (/etc/hosts)

egress_names() {
    PROXY=$NAME-egress
    EGRESS_NET=$NAME-internal
    EGRESS_IMAGE=${CCU_EGRESS_IMAGE:-localhost/containercomp-egress:latest}
}

egress_state() { podman container inspect -f '{{.State.Status}}' "$PROXY" 2>/dev/null || echo missing; }

# "on" if the desktop was created with egress filtering, empty otherwise.
egress_label() {
    podman container inspect -f '{{index .Config.Labels "containercomp.egress"}}' "$NAME" 2>/dev/null || true
}

egress_build() {
    echo "building $EGRESS_IMAGE (egress proxy)" >&2
    podman build -t "$EGRESS_IMAGE" -f "$REPO/egress/Containerfile" "$REPO/egress"
}

# Print FILE as squid dstdomain lines: lowercase, "*.x" -> ".x", sorted, and
# without entries that a wildcard already covers. Dies on malformed lines.
egress_normalize() {
    [ -f "$1" ] || die "allowlist file '$1' not found"
    local entries bad
    entries=$(sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | tr 'A-Z' 'a-z')
    bad=$(printf '%s\n' "$entries" \
        | grep -vE '^$|^(\*?\.)?[a-z0-9_]([a-z0-9_-]*[a-z0-9])?(\.[a-z0-9_]([a-z0-9_-]*[a-z0-9])?)*$' || true)
    [ -z "$bad" ] || die "bad allowlist entries in $1: $(printf '%s' "$bad" | tr '\n' ' ')
(one host name per line: example.com, *.example.com or .example.com; no URLs or ports)"
    printf '%s\n' "$entries" | sed 's/^\*\././' | sort -u | awk '
        NF { e[++n] = $0 }
        END {
            for (i = 1; i <= n; i++) {
                x = e[i]; covered = 0
                for (j = 1; j <= n; j++) {
                    w = e[j]
                    if (i == j || substr(w, 1, 1) != ".") continue
                    if (x == substr(w, 2) || (length(x) > length(w) && substr(x, length(x) - length(w) + 1) == w)) covered = 1
                }
                if (!covered) print x
            }
        }'
}

# Turn a request (FILE or "offline") into $EGRESS_LIST.
egress_load() {
    EGRESS_LIST=$(mktemp "${TMPDIR:-/tmp}/ccu-egress.XXXXXX")
    trap 'rm -f "$EGRESS_LIST"' EXIT
    if [ "$1" != offline ]; then
        egress_normalize "$1" > "$EGRESS_LIST"
    fi
    chmod 0644 "$EGRESS_LIST"
}

egress_parse_up() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --egress) [ $# -ge 2 ] || die "usage: ccu up --egress FILE"; EGRESS_REQ=$2; shift 2 ;;
            --egress=*) EGRESS_REQ=${1#*=}; shift ;;
            --offline) EGRESS_REQ=offline; shift ;;
            *) die "unknown option for up: $1 (see: ccu help)" ;;
        esac
    done
    if [ -n "$EGRESS_REQ" ]; then egress_load "$EGRESS_REQ"; fi
}

# Copy $EGRESS_LIST into the proxy; a running squid re-reads it on SIGHUP.
egress_apply() {
    local n
    podman cp "$EGRESS_LIST" "$PROXY:/etc/squid/allowlist.txt"
    if [ "$(egress_state)" = running ]; then
        podman kill -s HUP "$PROXY" >/dev/null
    fi
    n=$(grep -c . "$EGRESS_LIST" || true)
    if [ "$n" = 0 ]; then echo "egress: offline, nothing is allowed" >&2
    else echo "egress: $n allowlisted domain(s)" >&2; fi
}

# Before `up` touches an existing desktop: a desktop's network mode is fixed at
# creation, so refuse to change it; otherwise update the list and start the proxy.
egress_pre_up() {
    [ "$(state)" != missing ] || return 0
    if [ -z "$(egress_label)" ]; then
        [ -z "$EGRESS_REQ" ] || die "'$NAME' was created without egress filtering; recreate it (this discards its state) with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
        return 0
    fi
    [ "$(egress_state)" != missing ] || die "egress proxy '$PROXY' is missing; recreate the desktop with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
    if [ -n "$EGRESS_REQ" ]; then egress_apply; fi
    [ "$(egress_state)" = running ] || podman start "$PROXY" >/dev/null
}

# For a new desktop: create the internal network and the proxy, and set
# EGRESS_ARGS for `podman run`. No-op unless egress filtering was requested.
egress_create() {
    [ -n "$EGRESS_REQ" ] || return 0
    podman image exists "$EGRESS_IMAGE" || egress_build
    # Leftovers from a desktop that was removed outside ccu.
    podman rm -f "$PROXY" >/dev/null 2>&1 || true
    if podman network exists "$EGRESS_NET"; then podman network rm "$EGRESS_NET" >/dev/null; fi
    podman network create --internal --disable-dns --label containercomp.egress-for="$NAME" "$EGRESS_NET" >/dev/null
    local subnet base proxy noproxy=localhost,127.0.0.1,::1
    subnet=$(podman network inspect -f '{{range .Subnets}}{{.Subnet}}{{end}}' "$EGRESS_NET")
    case "$subnet" in
        *.0/24) base=${subnet%.0/24} ;;
        *) die "unexpected subnet '$subnet' on $EGRESS_NET (expected a /24)" ;;
    esac
    # Fixed addresses: the network has no DNS, so the desktop reaches the proxy
    # through an /etc/hosts entry.
    podman create --name "$PROXY" --hostname "$PROXY" \
        --network podman --network "$EGRESS_NET:ip=$base.2" \
        --label containercomp.egress-for="$NAME" \
        "$EGRESS_IMAGE" >/dev/null
    egress_apply
    podman start "$PROXY" >/dev/null
    proxy=http://$EGRESS_HOST:3128
    EGRESS_ARGS=(--network "$EGRESS_NET" --ip "$base.3" --dns 127.0.0.1
        --add-host "$EGRESS_HOST:$base.2"
        --cap-drop NET_ADMIN --cap-drop NET_RAW
        -e CCU_EGRESS_PROXY="$proxy"
        -e http_proxy="$proxy" -e https_proxy="$proxy" -e HTTP_PROXY="$proxy" -e HTTPS_PROXY="$proxy"
        -e no_proxy="$noproxy" -e NO_PROXY="$noproxy"
        --label containercomp.egress=on)
}

egress_stop() {
    if [ "$(egress_state)" = running ]; then podman stop -t 2 "$PROXY" >/dev/null && echo "stopped $PROXY"; fi
}

egress_rm() {
    if podman container exists "$PROXY"; then podman rm -f "$PROXY" >/dev/null && echo "removed $PROXY"; fi
    if podman network exists "$EGRESS_NET"; then podman network rm "$EGRESS_NET" >/dev/null && echo "removed network $EGRESS_NET"; fi
}

# Print a file from the proxy container (running or stopped).
egress_cat() {
    local tmp rc=0
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ccu-egress.XXXXXX")
    podman cp "$PROXY:$1" "$tmp/f" >/dev/null 2>&1 && cat "$tmp/f" || rc=1
    rm -rf "$tmp"
    return $rc
}

egress_summary() {
    local n
    if [ "$(state)" = missing ]; then echo "-"; return; fi
    if [ -z "$(egress_label)" ]; then echo "unrestricted"; return; fi
    n=$(egress_cat /etc/squid/allowlist.txt | grep -c . || true)
    if [ "$n" = 0 ]; then printf 'offline (nothing allowed)'
    else printf 'allowlist (%s domain(s))' "$n"; fi
    echo "; proxy $PROXY ($(egress_state)); blocked requests: ccu${TARGET_FLAG} egress log"
}

egress_log() {
    local follow=0 n=50 pat=_DENIED/
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--follow) follow=1; shift ;;
            --all) pat=.; shift ;;
            -n) [ $# -ge 2 ] || die "usage: ccu egress log -n N"; n=$2; shift 2 ;;
            *) die "usage: ccu egress log [-f] [--all] [-n N]" ;;
        esac
    done
    [ "$(egress_state)" != missing ] || die "'$NAME' has no egress proxy (it was not started with --egress or --offline)"
    if [ "$follow" = 1 ]; then
        [ "$(egress_state)" = running ] || die "egress proxy '$PROXY' is not running; start it with: ccu${TARGET_FLAG} up"
        podman exec "$PROXY" tail -n "$n" -F /var/log/squid/access.log | grep --line-buffered -e "$pat"
    else
        egress_cat /var/log/squid/access.log | grep -e "$pat" | tail -n "$n" || true
    fi
}

cmd_egress() {
    local sub=${1:-status}
    [ $# -eq 0 ] || shift
    case "$sub" in
        status)
            echo "egress:    $(egress_summary)"
            if [ -n "$(egress_label)" ]; then egress_cat /etc/squid/allowlist.txt | sed 's/^/  /'; fi
            ;;
        log) egress_log "$@" ;;
        set)
            [ $# -eq 1 ] || die "usage: ccu egress set FILE|offline"
            [ "$(state)" != missing ] || die "container '$NAME' does not exist; create it with: ccu${TARGET_FLAG} up --egress FILE"
            [ -n "$(egress_label)" ] || die "'$NAME' was created without egress filtering; recreate it with: ccu${TARGET_FLAG} rm && ccu${TARGET_FLAG} up --egress FILE"
            egress_load "$1"
            egress_apply
            ;;
        build) egress_build ;;
        *) die "usage: ccu egress [status | log [-f] [--all] [-n N] | set FILE|offline | build]" ;;
    esac
}

# --- main ---------------------------------------------------------------------

TARGET_FLAG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target) TARGET=$2; TARGET_FLAG=" -t $2"; shift 2 ;;
        --target=*) TARGET=${1#*=}; TARGET_FLAG=" -t ${1#*=}"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done
set_target
egress_names
[ $# -gt 0 ] || { usage; exit 1; }
cmd=$1; shift

# --shot: screenshot after a control command.
SHOT=0
if [ $# -gt 0 ]; then
    rest=()
    for a in "$@"; do
        if [ "$a" = --shot ]; then SHOT=1; else rest+=("$a"); fi
    done
    set -- ${rest[@]+"${rest[@]}"}
fi

case "$cmd" in
    help) usage ;;
    build) cmd_build ;;
    up|start) cmd_up "$@" ;;
    down|stop) podman stop -t 5 "$NAME" >/dev/null && echo "stopped $NAME"; egress_stop ;;
    rm|reset) podman rm -f "$NAME" >/dev/null && echo "removed $NAME"; egress_rm ;;
    status) cmd_status ;;
    open) require_running; open "http://localhost:$PORT/" ;;
    logs)
        require_running
        if [ $# -gt 0 ]; then podman exec "$NAME" tail -n 200 "/var/log/ccu/$1.log"
        else podman logs --tail 200 "$NAME"; fi
        ;;
    shell)
        require_running
        if [ "${1:-}" = --root ]; then podman exec -it -e DISPLAY=:1 "$NAME" bash
        else podman exec -it -u user -w /home/user -e DISPLAY=:1 "$NAME" bash -l; fi
        ;;
    exec)
        require_running
        if [ "${1:-}" = --root ]; then shift; podman exec -e DISPLAY=:1 "$NAME" "$@"
        else pexec "$@"; fi
        ;;
    mcp)
        # Don't auto-start: Claude Code spawns MCP servers at every session start.
        require_running
        exec podman exec -i -u user -w /home/user -e DISPLAY=:1 "$NAME" /opt/ccu/venv/bin/python /opt/ccu/mcp_server.py
        ;;
    egress) cmd_egress "$@" ;;
    install) require_running; cmd_install "$@" ;;
    cp-in) require_running; cmd_cp_in "$@" ;;
    cp-out) require_running; cmd_cp_out "$@" ;;
    screenshot) require_running; cmd_screenshot "$@" ;;
    zoom) require_running; cmd_zoom "$@" ;;
    click|double_click|triple_click|right_click|middle_click|move|mouse_down|mouse_up|drag|scroll|type|key|launch|focus|wait_window|wait|windows|active|size|cursor)
        require_running
        pexec cu "$cmd" "$@"
        if [ "$SHOT" = 1 ]; then
            sleep 0.6
            cmd_screenshot
        fi
        ;;
    *) die "unknown command '$cmd' (see: ccu help)" ;;
esac
