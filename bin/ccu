#!/bin/bash
# ccu: run and control the containercomp desktop from the Mac host.
# Run `ccu help` for usage.
set -euo pipefail

# Resolve the repo root through symlinks (macOS bash 3.2 has no readlink -f guarantee).
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src=$dir/$src ;; esac
done
REPO=$(cd -P "$(dirname "$src")/.." && pwd)

TARGET=${CCU_TARGET:-native}
SHOT_DIR=${CCU_SHOT_DIR:-${TMPDIR:-/tmp}/ccu}
SCREEN=${CCU_SCREEN:-1280x800}

usage() {
    cat <<'EOF'
ccu: a Linux desktop in a Podman container, driven by mouse/keyboard/screenshots.

usage: ccu [-t native|x86] <command> [args]

  -t native   arm64 Ubuntu desktop (default, fast)
  -t x86      amd64 Ubuntu desktop under emulation, with Wine for Windows apps
              (or set CCU_TARGET=x86)

Lifecycle
  build                 build (or rebuild) the image
  up                    start the desktop (builds the image first if needed)
  down                  stop the container (state is kept)
  rm                    delete the container (state is lost; the image stays)
  status                show container status and the viewer URL
  open                  open the noVNC viewer in your browser
  logs [service]        desktop logs (xvfb, desktop, x11vnc, novnc)
  shell [--root]        interactive shell in the container
  exec [--root] CMD...  run a command in the container
  mcp                   stdio MCP server (for `claude mcp add containercomp -- ccu mcp`)

Apps and files
  install TARGET...     apt package names, URLs, or host files (.deb, .AppImage,
                        .exe/.msi on x86, archives); host files go to ~/apps
  cp-in HOST [DEST]     copy a host file into the container (default ~/apps/)
  cp-out SRC [HOST]     copy a container file to the host (default: current dir)

Corporate networks (TLS-inspecting proxies such as Zscaler or Netskope)
  certs sync [--machine]   copy the extra roots macOS trusts (keychains, MDM) for
                        the container; --machine also trusts them in the podman VM
                        (for podman pull; changes the VM shared by all containers)
  certs add FILE [NAME] trust a CA file (PEM or DER); for non-mac hosts too
  certs rm NAME | certs list | certs apply   (apply re-pushes to the running one)
  Stored certs apply on every `up`, to the running container, and to `build`.
  HTTP(S)_PROXY / NO_PROXY from your shell are passed in when the container is
  created (localhost becomes host.containers.internal); CCU_PROXY=0 disables.

Screen control (coordinates are screen pixels; screenshot pixels = click pixels)
  screenshot [FILE]     save a PNG, print its path
  zoom X0 Y0 X1 Y1 [--scale N] [FILE]   enlarged crop of a region
  click X Y [--button left|right|middle] [--mods ctrl+shift]
  double_click X Y | triple_click X Y | right_click X Y | middle_click X Y
  move X Y              mouse_down | mouse_up
  drag X0 Y0 X1 Y1
  scroll X Y up|down|left|right [AMOUNT]
  type TEXT             newlines press Return
  key COMBO...          xdotool names: ctrl+s Return Escape Tab alt+F4 super
  launch CMD...         start a GUI app in the background
  windows | active | size | cursor
  focus TITLE           raise the window whose title contains TITLE
  wait_window TITLE [--timeout S]
  wait SECONDS

Add --shot to any control command to take a screenshot afterwards and print its path.

Environment: CCU_TARGET, CCU_SCREEN (default 1280x800), CCU_PORT, CCU_SHOT_DIR,
VNC_PASSWORD (applied when the container is created), CCU_CA_FILE (extra CA
files, colon-separated), CCU_CERT_DIR (default ~/.config/containercomp/certs).
EOF
}

die() { echo "ccu: $*" >&2; exit 1; }

set_target() {
    case "$TARGET" in
        native|arm64) TARGET=native; PLATFORM=linux/arm64; NAME=${CCU_NAME:-ccu}; PORT=${CCU_PORT:-6080} ;;
        x86|amd64) TARGET=x86; PLATFORM=linux/amd64; NAME=${CCU_NAME:-ccu-x86}; PORT=${CCU_PORT:-6081} ;;
        *) die "unknown target '$TARGET' (use native or x86)" ;;
    esac
    IMAGE=${CCU_IMAGE:-localhost/containercomp:$TARGET}
}

state() { podman container inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo missing; }

require_running() {
    [ "$(state)" = running ] || die "container '$NAME' is not running; start it with: ccu${TARGET_FLAG} up"
}

# podman exec as the desktop user with the display env.
pexec() {
    podman exec -u user -w /home/user -e DISPLAY=:1 "$NAME" "$@"
}

ensure_machine() {
    # On macOS podman needs its Linux VM running.
    if [ "$(uname -s)" = Darwin ] && ! podman info >/dev/null 2>&1; then
        echo "starting podman machine..." >&2
        podman machine start >/dev/null 2>&1 || podman machine init --now \
            || die "could not start the podman machine; run 'podman machine init --now' manually"
    fi
}

cmd_build() {
    ensure_machine
    echo "building $IMAGE ($PLATFORM); the x86 build is slow under emulation" >&2
    # Behind a TLS-inspecting proxy the build needs its CA and proxy too.
    local ca
    ca=$(ca_bundle)
    proxy_opts --build-arg
    [ -z "$ca" ] || PROXY_OPTS+=(--build-arg "CCU_EXTRA_CA=$ca")
    podman build ${PROXY_OPTS[@]+"${PROXY_OPTS[@]}"} --platform "$PLATFORM" -t "$IMAGE" -f "$REPO/Containerfile" "$REPO"
}

wait_ready() {
    local i
    for i in $(seq 1 90); do
        if pexec xdotool getdisplaygeometry >/dev/null 2>&1 && pexec test -f /home/user/.cache/ccu/session.env; then
            # Give the panel and window manager a moment to map.
            sleep 2
            return 0
        fi
        sleep 1
    done
    die "desktop did not come up; check: ccu${TARGET_FLAG} logs desktop"
}

check_rosetta() {
    # On Apple Silicon, x86 runs far better (and 64-bit Windows apps only work)
    # with Rosetta, which Podman 5.6+ leaves disabled by default.
    [ "$TARGET" = x86 ] && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || return 0
    podman machine ssh 'test -e /proc/sys/fs/binfmt_misc/rosetta' >/dev/null 2>&1 && return 0
    cat >&2 <<'EOF'
warning: Rosetta is not active in the podman machine, so x86 runs under qemu
(slow, and Wine fails to load most .exe files). On macOS 26+ enable it with:
  podman machine ssh "sudo touch /etc/containers/enable-rosetta"
  podman machine stop && podman machine start
EOF
}

cmd_up() {
    ensure_machine
    check_rosetta
    case "$(state)" in
        running) ;;
        missing)
            podman image exists "$IMAGE" || cmd_build
            local w=${SCREEN%x*} h=${SCREEN#*x}
            proxy_opts -e
            podman run -d --name "$NAME" --hostname "$NAME" \
                --platform "$PLATFORM" \
                -p "127.0.0.1:$PORT:6080" \
                --shm-size 2g \
                -e SCREEN_WIDTH="$w" -e SCREEN_HEIGHT="$h" \
                -e VNC_PASSWORD="${VNC_PASSWORD:-}" \
                --label containercomp.target="$TARGET" \
                ${PROXY_OPTS[@]+"${PROXY_OPTS[@]}"} \
                "$IMAGE" >/dev/null
            ;;
        *) podman start "$NAME" >/dev/null ;;
    esac
    netsetup apply
    wait_ready
    echo "desktop '$NAME' is up: $(pexec cu size | tr ' ' x) at http://localhost:$PORT/"
}

cmd_status() {
    local s
    s=$(state)
    echo "target:    $TARGET ($PLATFORM)"
    echo "container: $NAME ($s)"
    echo "image:     $IMAGE ($(podman image exists "$IMAGE" && echo present || echo 'not built'))"
    if [ "$s" = running ]; then
        echo "viewer:    http://localhost:$PORT/"
        echo "screen:    $(pexec cu size | tr ' ' x)"
        echo "windows:"
        pexec cu windows | sed 's/^/  /'
    fi
}

new_shot_path() {
    mkdir -p "$SHOT_DIR"
    echo "$SHOT_DIR/$NAME-$(date +%Y%m%d-%H%M%S)-$$-$RANDOM.png"
}

cmd_screenshot() {
    local out=${1:-$(new_shot_path)}
    pexec cu screenshot > "$out"
    [ -s "$out" ] || die "screenshot failed"
    echo "$out"
}

cmd_zoom() {
    local args=() out=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --scale) args+=("$1" "$2"); shift 2 ;;
            *.png) out=$1; shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ -n "$out" ] || out=$(new_shot_path)
    pexec cu zoom "${args[@]}" > "$out"
    [ -s "$out" ] || die "zoom failed"
    echo "$out"
}

cmd_install() {
    [ $# -gt 0 ] || die "usage: ccu install <apt-package|url|host-file>..."
    local targets=() a dest
    for a in "$@"; do
        if [ -f "$a" ]; then
            dest=/home/user/apps/$(basename "$a")
            podman exec "$NAME" mkdir -p /home/user/apps
            podman cp "$a" "$NAME:$dest"
            podman exec "$NAME" chown user:user /home/user/apps "$dest"
            targets+=("$dest")
        else
            targets+=("$a")
        fi
    done
    podman exec -e DISPLAY=:1 "$NAME" /usr/local/bin/ccu-install "${targets[@]}"
}

cmd_cp_in() {
    [ $# -ge 1 ] || die "usage: ccu cp-in HOST_PATH [CONTAINER_DEST]"
    local dest=${2:-/home/user/apps/}
    podman exec "$NAME" mkdir -p /home/user/apps
    podman cp "$1" "$NAME:$dest"
    podman exec "$NAME" chown -R user:user /home/user/apps
    case "$dest" in /home/user/*) podman exec "$NAME" chown -R user:user "$dest" ;; esac
    echo "copied to $dest"
}

cmd_cp_out() {
    [ $# -ge 1 ] || die "usage: ccu cp-out CONTAINER_PATH [HOST_DEST]"
    local src=$1
    case "$src" in /*) ;; *) src=/home/user/$src ;; esac
    podman cp "$NAME:$src" "${2:-.}"
}

# --- corporate networks: extra CA certificates and proxy passthrough ----------

CERT_DIR=${CCU_CERT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/containercomp/certs}

# Print a cert file as PEM (accepts PEM bundles and DER).
pem_of() {
    if grep -q 'BEGIN CERTIFICATE' "$1"; then cat "$1"
    else openssl x509 -inform DER -in "$1" || die "$1 is not a PEM or DER certificate"; fi
}

# Every extra CA that ccu applies: the stored ones plus CCU_CA_FILE (colon-separated).
ca_bundle() {
    local f
    for f in "$CERT_DIR"/*.pem; do
        if [ -f "$f" ]; then cat "$f"; echo; fi
    done
    if [ -n "${CCU_CA_FILE:-}" ]; then
        local IFS=:
        for f in $CCU_CA_FILE; do
            [ -f "$f" ] || die "CCU_CA_FILE: no such file: $f"
            pem_of "$f"; echo
        done
    fi
}

# Self-signed CA roots that macOS trusts for TLS beyond Apple's built-in roots:
# what an admin, MDM profile or user added (e.g. a Zscaler/Netskope root).
keychain_roots() {
    local tmp f fp builtin
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/ccu-certs.XXXXXX")
    builtin=$(security find-certificate -a -Z /System/Library/Keychains/SystemRootCertificates.keychain \
        | awk '/^SHA-256 hash:/ {print $3}')
    {
        security find-certificate -a -p /Library/Keychains/System.keychain
        security list-keychains -d user | sed 's/^ *"//; s/" *$//' | while IFS= read -r f; do
            security find-certificate -a -p "$f"
        done
    } 2>/dev/null | awk -v d="$tmp" '
        /-----BEGIN CERTIFICATE-----/ { n++; f = sprintf("%s/%04d.pem", d, n) }
        f { print > f }
        /-----END CERTIFICATE-----/ { close(f); f = "" }'
    for f in "$tmp"/*.pem; do
        [ -f "$f" ] || continue
        openssl x509 -in "$f" -noout -text 2>/dev/null | grep -q 'CA:TRUE' || continue
        openssl x509 -in "$f" -noout -checkend 0 >/dev/null 2>&1 || continue
        [ "$(openssl x509 -in "$f" -noout -subject | sed 's/^subject= *//')" = \
          "$(openssl x509 -in "$f" -noout -issuer | sed 's/^issuer= *//')" ] || continue
        fp=$(openssl x509 -in "$f" -noout -fingerprint -sha256 | sed 's/.*=//; s/://g')
        case "$builtin" in *"$fp"*) continue ;; esac
        # Trusted per the admin/user trust settings (offline). The ssl policy alone
        # rejects public roots over CT, so it is only a fallback for roots
        # trusted for SSL only.
        security verify-cert -q -L -l -R offline -p basic -c "$f" >/dev/null 2>&1 \
            || security verify-cert -q -L -l -R offline -p ssl -c "$f" >/dev/null 2>&1 || continue
        cat "$f"
    done
    rm -rf "$tmp"
}

# Run the in-container helper as root with the CA bundle on stdin. Containers
# from images that predate it get a copy.
netsetup() {
    podman exec "$NAME" test -x /opt/ccu/bin/netsetup \
        || podman cp "$REPO/rootfs/opt/ccu/bin/netsetup" "$NAME:/opt/ccu/bin/netsetup"
    ca_bundle | podman exec -i "$NAME" /opt/ccu/bin/netsetup "$1"
}

# Rewrite a proxy URL whose host is the Mac's loopback: inside the container
# that host is host.containers.internal.
container_url() {
    printf '%s\n' "$1" | sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)?([^@/]*@)?(localhost|127\.0\.0\.1|\[::1\])([:/]|$)#\1\2host.containers.internal\4#'
}

# Host proxy env as podman options in PROXY_OPTS; $1 is -e or --build-arg.
# Both spellings are set because tools disagree on which one they read.
proxy_opts() {
    PROXY_OPTS=()
    if [ "${CCU_PROXY:-1}" = 0 ]; then PROXY_OPTS=(--http-proxy=false); return 0; fi
    local v V val any=0
    for v in http_proxy https_proxy all_proxy no_proxy; do
        V=$(echo "$v" | tr a-z A-Z)
        val=${!v:-${!V:-}}
        if [ "$v" = no_proxy ]; then
            [ "$any" = 1 ] || continue
            val=${val:+$val,}localhost,127.0.0.1,::1,host.containers.internal
        else
            [ -n "$val" ] || continue
            any=1
            val=$(container_url "$val")
        fi
        PROXY_OPTS+=("$1" "$v=$val" "$1" "$V=$val")
    done
}

# Opt-in only: trust the same CAs in the podman machine VM, so `podman pull`
# works behind the proxy. It changes the VM, which all containers share.
machine_certs() {
    [ "$(uname -s)" = Darwin ] || die "--machine is for the podman machine VM on macOS; on Linux, add the CA to the host trust store"
    local n anchor=/etc/pki/ca-trust/source/anchors/containercomp.pem
    n=$(ca_bundle | grep -c 'BEGIN CERTIFICATE' || true)
    if [ "$n" -gt 0 ]; then
        ca_bundle | podman machine ssh "sudo tee $anchor >/dev/null && sudo update-ca-trust"
        echo "podman machine: trusting $n extra CA certificate(s) ($anchor)"
    else
        podman machine ssh "sudo rm -f $anchor && sudo update-ca-trust"
        echo "podman machine: removed $anchor"
    fi
    echo "if podman pull still fails with certificate errors, restart the VM (stops every container):"
    echo "  podman machine stop && podman machine start"
}

certs_show() {
    echo "  $1"
    pem_of "$2" | openssl crl2pkcs7 -nocrl -certfile /dev/stdin \
        | openssl pkcs7 -print_certs -noout | sed -n 's/^subject= */    /p'
}

cmd_certs() {
    local sub=${1:-list} machine=0 a f args=()
    [ $# -eq 0 ] || shift
    for a in "$@"; do
        if [ "$a" = --machine ]; then machine=1; else args+=("$a"); fi
    done
    set -- ${args[@]+"${args[@]}"}
    case "$sub" in
        sync)
            [ "$(uname -s)" = Darwin ] || die "certs sync reads the macOS keychains; elsewhere use: ccu certs add FILE.pem"
            mkdir -p "$CERT_DIR"; f=$CERT_DIR/macos-keychain.pem
            keychain_roots > "$f.tmp"
            if [ -s "$f.tmp" ]; then
                mv "$f.tmp" "$f"
                echo "macOS keychains: $(grep -c 'BEGIN CERTIFICATE' "$f") extra trusted root(s) -> $f"
            else
                rm -f "$f.tmp" "$f"
                echo "macOS keychains: no trusted roots beyond Apple's built-in ones"
            fi
            ;;
        add)
            [ $# -ge 1 ] && [ -f "$1" ] || die "usage: ccu certs add FILE.pem|FILE.crt|FILE.der [NAME]"
            mkdir -p "$CERT_DIR"; f=$CERT_DIR/${2:-$(basename "${1%.*}")}.pem
            pem_of "$1" > "$f.tmp"
            grep -q 'BEGIN CERTIFICATE' "$f.tmp" || { rm -f "$f.tmp"; die "no certificate found in $1"; }
            mv "$f.tmp" "$f"
            echo "added $f"
            ;;
        rm)
            [ $# -ge 1 ] || die "usage: ccu certs rm NAME (see: ccu certs list)"
            [ -f "$CERT_DIR/${1%.pem}.pem" ] || die "no such cert: $1 (see: ccu certs list)"
            rm "$CERT_DIR/${1%.pem}.pem"
            echo "removed $1"
            ;;
        list)
            echo "extra CAs in $CERT_DIR:"
            for f in "$CERT_DIR"/*.pem; do
                if [ -s "$f" ]; then certs_show "$(basename "${f%.pem}")" "$f"; fi
            done
            if [ -n "${CCU_CA_FILE:-}" ]; then
                local IFS=:
                for f in $CCU_CA_FILE; do certs_show "$f (CCU_CA_FILE)" "$f"; done
            fi
            return 0
            ;;
        apply) ;;
        *) die "usage: ccu certs sync|add|rm|list|apply [--machine]" ;;
    esac
    if [ "$(state)" = running ]; then netsetup certs
    else echo "'$NAME' is not running; the certs apply at the next: ccu${TARGET_FLAG} up"; fi
    if [ "$machine" = 1 ]; then machine_certs; fi
}

# --- main ---------------------------------------------------------------------

TARGET_FLAG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target) TARGET=$2; TARGET_FLAG=" -t $2"; shift 2 ;;
        --target=*) TARGET=${1#*=}; TARGET_FLAG=" -t ${1#*=}"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done
set_target
[ $# -gt 0 ] || { usage; exit 1; }
cmd=$1; shift

# --shot: screenshot after a control command.
SHOT=0
if [ $# -gt 0 ]; then
    rest=()
    for a in "$@"; do
        if [ "$a" = --shot ]; then SHOT=1; else rest+=("$a"); fi
    done
    set -- ${rest[@]+"${rest[@]}"}
fi

case "$cmd" in
    help) usage ;;
    build) cmd_build ;;
    up|start) cmd_up ;;
    down|stop) podman stop -t 5 "$NAME" >/dev/null && echo "stopped $NAME" ;;
    rm|reset) podman rm -f "$NAME" >/dev/null && echo "removed $NAME" ;;
    status) cmd_status ;;
    open) require_running; open "http://localhost:$PORT/" ;;
    logs)
        require_running
        if [ $# -gt 0 ]; then podman exec "$NAME" tail -n 200 "/var/log/ccu/$1.log"
        else podman logs --tail 200 "$NAME"; fi
        ;;
    shell)
        require_running
        if [ "${1:-}" = --root ]; then podman exec -it -e DISPLAY=:1 "$NAME" bash
        else podman exec -it -u user -w /home/user -e DISPLAY=:1 "$NAME" bash -l; fi
        ;;
    exec)
        require_running
        if [ "${1:-}" = --root ]; then shift; podman exec -e DISPLAY=:1 "$NAME" "$@"
        else pexec "$@"; fi
        ;;
    mcp)
        # Don't auto-start: Claude Code spawns MCP servers at every session start.
        require_running
        exec podman exec -i -u user -w /home/user -e DISPLAY=:1 "$NAME" /opt/ccu/venv/bin/python /opt/ccu/mcp_server.py
        ;;
    install) require_running; cmd_install "$@" ;;
    cp-in) require_running; cmd_cp_in "$@" ;;
    cp-out) require_running; cmd_cp_out "$@" ;;
    certs) cmd_certs "$@" ;;
    screenshot) require_running; cmd_screenshot "$@" ;;
    zoom) require_running; cmd_zoom "$@" ;;
    click|double_click|triple_click|right_click|middle_click|move|mouse_down|mouse_up|drag|scroll|type|key|launch|focus|wait_window|wait|windows|active|size|cursor)
        require_running
        pexec cu "$cmd" "$@"
        if [ "$SHOT" = 1 ]; then
            sleep 0.6
            cmd_screenshot
        fi
        ;;
    *) die "unknown command '$cmd' (see: ccu help)" ;;
esac
